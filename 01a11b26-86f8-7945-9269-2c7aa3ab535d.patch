+"""Privacy-first CV helpers. Only anonymous counts leave this module."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+
+class VisionError(RuntimeError):
+    pass
+
+
+class VisionEngine:
+    def __init__(self) -> None:
+        self._cv2 = None
+        self._model = None
+        self._model_error: str | None = None
+        self._hog = None
+
+    def _load(self):
+        if self._cv2 is not None:
+            return self._cv2
+        try:
+            import cv2
+            self._cv2 = cv2
+            model_path = os.getenv("YOLO_MODEL_PATH", "").strip()
+            if model_path and Path(model_path).is_file():
+                try:
+                    from ultralytics import YOLO
+                    self._model = YOLO(model_path)
+                except Exception as exc:  # optional dependency/weights
+                    self._model_error = str(exc)
+            if self._model is None:
+                self._hog = cv2.HOGDescriptor()
+                self._hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())
+            return cv2
+        except ImportError as exc:
+            raise VisionError("OpenCV is not installed. Start the backend with backend/requirements.txt to analyze uploaded video.") from exc
+
+    @property
+    def status(self) -> dict:
+        model_path = os.getenv("YOLO_MODEL_PATH", "").strip()
+        if model_path and Path(model_path).is_file():
+            return {"mode": "YOLO", "ready": True, "privacy": "anonymous counts only"}
+        try:
+            self._load()
+            return {"mode": "OpenCV HOG", "ready": True, "privacy": "anonymous counts only", "note": "Set YOLO_MODEL_PATH to use approved YOLO weights."}
+        except VisionError:
+            return {"mode": "DEMO SIMULATOR", "ready": True, "privacy": "anonymous counts only", "note": "OpenCV is not installed; live demo data remains available."}
+
+    def _detect(self, frame) -> tuple[int, int, float]:
+        cv2 = self._load()
+        if self._model is not None:
+            result = self._model.predict(frame, verbose=False, conf=0.35)[0]
+            people = vehicles = 0
+            confidences = []
+            names = getattr(result, "names", {})
+            if result.boxes is not None:
+                for box in result.boxes:
+                    cls = int(box.cls[0])
+                    label = str(names.get(cls, cls)).lower()
+                    confidence = float(box.conf[0])
+                    if label in {"person", "0"}:
+                        people += 1
+                    elif label in {"car", "motorcycle", "bicycle", "bus", "truck", "vehicle"}:
+                        vehicles += 1
+                    confidences.append(confidence)
+            return people, vehicles, sum(confidences) / max(1, len(confidences))
+        boxes, _weights = self._hog.detectMultiScale(frame, winStride=(8, 8), padding=(8, 8), scale=1.08)
+        return len(boxes), 0, 0.55 if len(boxes) else 0.0
+
+    def analyze_video(self, path: str, sample_seconds: float = 1.0) -> dict:
+        cv2 = self._load()
+        capture = cv2.VideoCapture(path)
+        if not capture.isOpened():
+            capture.release()
+            raise VisionError("The uploaded video could not be opened. Try an MP4, MOV, or AVI file.")
+        fps = capture.get(cv2.CAP_PROP_FPS) or 15.0
+        frame_count = int(capture.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
+        sample_step = max(1, int(fps * max(0.5, min(sample_seconds, 5.0))))
+        people, vehicles, confidence, samples = [], [], [], 0
+        index = 0
+        while True:
+            ok, frame = capture.read()
+            if not ok:
+                break
+            if index % sample_step == 0:
+                # Reduce resolution before inference to keep demo processing responsive.
+                height, width = frame.shape[:2]
+                if max(height, width) > 960:
+                    scale = 960 / max(height, width)
+                    frame = cv2.resize(frame, (int(width * scale), int(height * scale)))
+                p, v, c = self._detect(frame)
+                people.append(p)
+                vehicles.append(v)
+                confidence.append(c)
+                samples += 1
+            index += 1
+        capture.release()
+        if samples == 0:
+            raise VisionError("No readable frames were found in this video.")
+        return {
+            "sampled_frames": samples,
+            "video_frames": frame_count or index,
+            "sample_rate_fps": round(1 / max(sample_seconds, 0.5), 2),
+            "average_people": round(sum(people) / samples),
+            "peak_people": max(people, default=0),
+            "average_vehicles": round(sum(vehicles) / samples),
+            "peak_vehicles": max(vehicles, default=0),
+            "mean_confidence": round(sum(confidence) / samples, 3),
+            "model": "YOLO" if self._model else "OpenCV HOG",
+            "privacy": "No face recognition, identity tracking, or biometric templates are used.",
+        }
+
+    def analyze_stream(self, uri: str) -> dict:
+        """Sample one frame from an RTSP source; frame pixels are discarded after inference."""
+        cv2 = self._load()
+        capture = None
+        try:
+            params = []
+            for prop_name, value in (("CAP_PROP_OPEN_TIMEOUT_MSEC", 2000), ("CAP_PROP_READ_TIMEOUT_MSEC", 2000)):
+                prop = getattr(cv2, prop_name, None)
+                if prop is not None:
+                    params.extend([prop, value])
+            if params and hasattr(cv2, "CAP_FFMPEG"):
+                capture = cv2.VideoCapture(uri, cv2.CAP_FFMPEG, params)
+            else:
+                capture = cv2.VideoCapture(uri)
+            if not capture.isOpened():
+                raise VisionError("RTSP stream could not be opened from the backend network.")
+            capture.set(cv2.CAP_PROP_BUFFERSIZE, 1)
+            ok, frame = capture.read()
+            if not ok or frame is None:
+                raise VisionError("RTSP source opened, but no readable frame was received.")
+            height, width = frame.shape[:2]
+            if max(height, width) > 960:
+                scale = 960 / max(height, width)
+                frame = cv2.resize(frame, (int(width * scale), int(height * scale)))
+            people, vehicles, confidence = self._detect(frame)
+            return {"people": people, "vehicles": vehicles, "confidence": round(confidence, 3), "model": "YOLO" if self._model else "OpenCV HOG", "sampledFrames": 1, "privacy": "Frame pixels are discarded; only anonymous counts are returned."}
+        except VisionError:
+            raise
+        except Exception as exc:
+            raise VisionError("The RTSP feed could not be read by the configured backend decoder.") from exc
+        finally:
+            if capture is not None:
+                capture.release()
+
+    def analyze_image(self, content: bytes) -> dict:
+        cv2 = self._load()
+        import numpy as np
+        image = cv2.imdecode(np.frombuffer(content, dtype=np.uint8), cv2.IMREAD_COLOR)
+        if image is None:
+            raise VisionError("The uploaded image could not be decoded.")
+        people, vehicles, confidence = self._detect(image)
+        return {"people": people, "vehicles": vehicles, "confidence": round(confidence, 3), "model": "YOLO" if self._model else "OpenCV HOG", "privacy": "Counts only; no identity is inferred."}
+
+
+vision_engine = VisionEngine()
