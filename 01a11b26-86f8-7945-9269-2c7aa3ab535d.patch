+++ b/frontend/src/services/api.ts
@@ -0,0 +1,74 @@
+import type { AnalyticsData, AuthUser, Role, Snapshot } from '../types'
+
+export class ApiError extends Error {
+  status: number
+  constructor(message: string, status = 0) { super(message); this.name = 'ApiError'; this.status = status }
+}
+
+async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const headers = new Headers(init.headers)
+  const token = localStorage.getItem('campusiq-token')
+  if (token) headers.set('Authorization', `Bearer ${token}`)
+  if (init.body && !(init.body instanceof FormData) && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json')
+  let response: Response
+  try {
+    response = await fetch(`/api${path}`, { ...init, headers })
+  } catch {
+    throw new ApiError('CampusIQ could not reach the API. Check the backend connection and try again.')
+  }
+  if (!response.ok) {
+    let message = `Request failed (${response.status})`
+    try {
+      const error = await response.json()
+      message = typeof error.detail === 'string' ? error.detail : message
+    } catch { /* response had no JSON body */ }
+    if (response.status === 401) window.dispatchEvent(new CustomEvent('campusiq:unauthorized'))
+    throw new ApiError(message, response.status)
+  }
+  if (response.status === 204) return undefined as T
+  return response.json() as Promise<T>
+}
+
+const json = (body: unknown): string => JSON.stringify(body)
+
+export const api = {
+  request,
+  async demoLogin(role: Role = 'SUPER ADMIN') {
+    return request<{ accessToken: string; user: AuthUser }>('/auth/demo', { method: 'POST', body: json({ role }) })
+  },
+  async login(email: string, password: string) {
+    return request<{ accessToken: string; user: AuthUser }>('/auth/login', { method: 'POST', body: json({ email, password }) })
+  },
+  me: () => request<AuthUser>('/auth/me'),
+  snapshot: () => request<Snapshot>('/snapshot'),
+  analytics: (period: string) => request<AnalyticsData>(`/analytics?period=${encodeURIComponent(period)}`),
+  ask: (question: string) => request<{ answer: string; sources: string[]; generatedAt: string; privacy: string }>('/assistant/ask', { method: 'POST', body: json({ question }) }),
+  toggleDemo: (active: boolean) => request<{ active: boolean }>('/demo/toggle', { method: 'POST', body: json({ active }) }),
+  updateAlert: (id: string, status: 'ACKNOWLEDGED' | 'RESOLVED' | 'IGNORED') => request(`/alerts/${id}`, { method: 'PATCH', body: json({ status }) }),
+  toggleCamera: (id: string, body: { ai_enabled?: boolean; stream_active?: boolean }) => request(`/cameras/${id}`, { method: 'PATCH', body: json(body) }),
+  testCamera: (id: string) => request<{ ok: boolean; message: string }>(`/cameras/${id}/test`, { method: 'POST' }),
+  deleteCamera: (id: string) => request(`/cameras/${id}`, { method: 'DELETE' }),
+  createCamera: (body: { name: string; location: string; building_id: string; source_type: string; source_uri?: string }) => request('/cameras', { method: 'POST', body: json(body) }),
+  uploadVideo: (id: string, file: File) => {
+    const form = new FormData(); form.append('file', file); form.append('sample_seconds', '1')
+    return request<{ camera: unknown; analysis: Record<string, unknown> }>(`/cameras/${id}/upload`, { method: 'POST', body: form })
+  },
+  createEvent: (body: Record<string, unknown>) => request('/events', { method: 'POST', body: json(body) }),
+  updateEvent: (id: string, body: Record<string, unknown>) => request(`/events/${id}`, { method: 'PATCH', body: json(body) }),
+  deleteEvent: (id: string) => request(`/events/${id}`, { method: 'DELETE' }),
+  simulateSpike: (id: string) => request<{ snapshot: Snapshot }>(`/events/${id}/simulate-spike`, { method: 'POST' }),
+  updateSlot: (id: string, state: string) => request(`/parking/slots/${id}`, { method: 'PATCH', body: json({ state }) }),
+  updateResource: (id: string, status: string) => request(`/resources/${id}`, { method: 'PATCH', body: json({ status }) }),
+  createAlert: () => request('/alerts/test', { method: 'POST' }),
+  settings: () => request<{ retentionDays: number; privacyBlur: boolean; restrictedZones: string[]; demoMode: boolean; dataLabel: string }>('/settings'),
+  saveSettings: (body: Record<string, unknown>) => request('/settings', { method: 'PATCH', body: json(body) }),
+  health: () => request<{ overall: string; checkedAt: string; uptimeSeconds: number; services: { name: string; status: string; detail: string; latencyMs: number | null }[]; lastDataUpdate: string; privacy: Record<string, unknown> }>('/system/health'),
+  async exportCsv(period = '7d') {
+    const token = localStorage.getItem('campusiq-token')
+    const response = await fetch(`/api/analytics/export?period=${period}`, { headers: token ? { Authorization: `Bearer ${token}` } : {} })
+    if (!response.ok) throw new ApiError('Could not export analytics CSV.', response.status)
+    const blob = await response.blob()
+    const url = URL.createObjectURL(blob)
+    const link = document.createElement('a'); link.href = url; link.download = `campusiq-${period}-analytics.csv`; link.click(); URL.revokeObjectURL(url)
+  },
+}
