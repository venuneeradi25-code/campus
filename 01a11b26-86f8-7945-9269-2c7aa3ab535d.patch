+
+type Settings = { retentionDays: number; privacyBlur: boolean; restrictedZones: string[]; demoMode: boolean; dataLabel: string }
+type UserRow = { id: string; email: string; name: string; role: string; active: boolean }
+const roleOptions = ['SUPER ADMIN', 'CAMPUS ADMIN', 'SECURITY ADMIN', 'EVENT ADMIN']
+export function SettingsPage() {
+  const { user } = useAuth()
+  const [settings, setSettings] = useState<Settings | null>(null)
+  const [users, setUsers] = useState<UserRow[]>([])
+  const [zones, setZones] = useState('')
+  const [loading, setLoading] = useState(true)
+  const [saving, setSaving] = useState(false)
+  const [showPassword, setShowPassword] = useState(false)
+  const [currentPassword, setCurrentPassword] = useState('')
+  const [newPassword, setNewPassword] = useState('')
+  const [privacyMessage, setPrivacyMessage] = useState('')
+  const canManage = user?.role === 'SUPER ADMIN' || user?.role === 'CAMPUS ADMIN'
+  const isSuper = user?.role === 'SUPER ADMIN'
+
+  useEffect(() => {
+    let alive = true
+    Promise.all([api.settings(), isSuper ? api.request<UserRow[]>('/users').catch(() => []) : Promise.resolve([])]).then(([data, usersData]) => {
+      if (!alive) return
+      setSettings(data); setZones(data.restrictedZones.join(', ')); setUsers(usersData); setLoading(false)
+    }).catch(e => { if (alive) { setLoading(false); notify('Settings could not load', e instanceof Error ? e.message : undefined, 'error') } })
+    return () => { alive = false }
+  }, [isSuper])
+
+  const save = async () => {
+    if (!settings) return
+    setSaving(true)
+    try {
+      const data = await api.saveSettings({ retention_days: settings.retentionDays, privacy_blur: settings.privacyBlur, restricted_zones: zones }) as { retentionDays: number; privacyBlur: boolean; restrictedZones: string[]; demoMode: boolean; dataLabel: string }
+      setSettings(data); setZones(data.restrictedZones.join(', ')); notify('Privacy settings saved', 'Updated controls are now stored by the CampusIQ backend.')
+    } catch (e) { notify('Could not save settings', e instanceof Error ? e.message : undefined, 'error') }
+    finally { setSaving(false) }
+  }
+  const changeRole = async (target: UserRow, role: string) => {
+    try { await api.request(`/users/${target.id}/role`, { method: 'PATCH', body: JSON.stringify({ role_name: role }) }); setUsers(rows => rows.map(row => row.id === target.id ? { ...row, role } : row)); notify('Role updated', `${target.name} now has the ${role} role.`) }
+    catch (e) { notify('Role update failed', e instanceof Error ? e.message : undefined, 'error') }
+  }
+  const updatePassword = async (e: React.FormEvent) => {
+    e.preventDefault(); setPrivacyMessage('')
+    try { await api.request('/auth/password', { method: 'POST', body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }) }); setCurrentPassword(''); setNewPassword(''); setPrivacyMessage('Password updated successfully.') }
+    catch (e) { setPrivacyMessage(e instanceof Error ? e.message : 'Password change could not be completed.') }
+  }
+  if (loading || !settings) return <div className="page-content settings-loading"><div /><div /><div /></div>
+  return <div className="page-content">
+    <PageHeading eyebrow="ADMINISTRATION / PRIVACY BY DESIGN" title="Privacy & settings" description="Campus-wide controls for anonymous analytics, data retention and role-based operations."><span className="settings-saved-indicator"><span className="table-live-dot" />Configuration saved</span><Button onClick={() => void save()} disabled={!canManage || saving}><Save size={15} />{saving ? 'Saving…' : 'Save changes'}</Button></PageHeading>
+    <div className="settings-layout"><div className="settings-main-column">
+      <section className="panel settings-panel privacy-settings-panel"><div className="settings-panel-heading"><span className="settings-icon settings-icon-green"><ShieldCheck size={18} /></span><div><span className="panel-kicker">PRIVACY FIRST</span><h2>Anonymous campus analytics</h2><p>CampusIQ is designed to understand activity, not identify people.</p></div><StatusPill status="HEALTHY" label="PRIVACY-FIRST DEFAULTS" /></div><div className="privacy-promise-grid"><div><span className="privacy-promise-icon"><EyeOff size={17} /></span><strong>Counts only</strong><small>People and vehicles are aggregated into anonymous estimates.</small></div><div><span className="privacy-promise-icon"><Fingerprint size={17} /></span><strong>No facial ID</strong><small>Facial recognition and biometric identification are not used.</small></div><div><span className="privacy-promise-icon"><Users2 size={17} /></span><strong>No identity tracking</strong><small>No individual student or staff movement profiles are created.</small></div></div><div className="settings-toggle-row"><div className="settings-toggle-copy"><strong>Privacy-masking preference</strong><small>Records a campus policy preference. This MVP does not display or retain camera frames; a production pipeline must enforce masks before any video display.</small></div><button className={`toggle-switch ${settings.privacyBlur ? 'toggle-on' : ''}`} role="switch" aria-checked={settings.privacyBlur} disabled={!canManage} onClick={() => setSettings({ ...settings, privacyBlur: !settings.privacyBlur })}><i /></button></div></section>
+      <section className="panel settings-panel retention-panel"><div className="settings-panel-heading"><span className="settings-icon settings-icon-blue"><RotateCcw size={17} /></span><div><span className="panel-kicker">DATA GOVERNANCE</span><h2>Retention & restricted zones</h2><p>Align campus settings with institutional requirements.</p></div></div><div className="settings-fields-grid"><label className="settings-field"><span>Analytics retention window</span><span className="field-with-icon"><select value={settings.retentionDays} disabled={!canManage} onChange={e => setSettings({ ...settings, retentionDays: Number(e.target.value) })}><option value={7}>7 days</option><option value={14}>14 days</option><option value={30}>30 days</option><option value={90}>90 days</option><option value={180}>180 days</option><option value={365}>365 days</option></select><ChevronDown size={14} /></span><small>Demonstration setting; institution policy governs production retention.</small></label><label className="settings-field"><span>Restricted-area labels</span><input value={zones} disabled={!canManage} onChange={e => setZones(e.target.value)} placeholder="e.g. Server Room, Service Corridor" /><small>Comma-separated location labels for safety-zone rules.</small></label></div><div className="settings-policy-callout"><Shield size={16} /><span>Video retention, notice, consent, and data access must follow institutional policy and applicable laws. Consult your privacy officer before deployment.</span></div></section>
+      <section className="panel settings-panel password-panel"><div className="settings-panel-heading"><span className="settings-icon settings-icon-amber"><KeyRound size={17} /></span><div><span className="panel-kicker">ACCOUNT SECURITY</span><h2>Password management</h2><p>Institution-provisioned passwords are never shown in CampusIQ.</p></div></div>{user?.demo ? <div className="demo-password-note"><LockKeyhole size={16} /><span>This is a passwordless demo session. Password changes are available for institution-provisioned accounts only.</span><button onClick={() => setShowPassword(true)}>Manage account</button></div> : <form className="password-change-form" onSubmit={updatePassword}><label>Current password<input type="password" minLength={8} value={currentPassword} onChange={e => setCurrentPassword(e.target.value)} required /></label><label>New password<input type="password" minLength={12} value={newPassword} onChange={e => setNewPassword(e.target.value)} required /></label><Button type="submit" variant="secondary">Update password</Button>{privacyMessage && <p className="password-form-message">{privacyMessage}</p>}</form>}</section>
+      {isSuper && <section className="panel settings-panel roles-panel"><div className="settings-panel-heading"><span className="settings-icon settings-icon-violet"><UserRoundCog size={18} /></span><div><span className="panel-kicker">ACCESS CONTROL</span><h2>Role management</h2><p>Assign least-privilege roles to campus operators.</p></div><button className="roles-info" title="Role permissions are enforced by the backend API"><CircleHelp size={16} /></button></div><div className="role-permission-strip">{roleOptions.map(role => <span key={role}><BadgeCheck size={13} />{role}</span>)}</div><div className="role-users-list">{users.map(account => <div className="role-user-row" key={account.id}><span className="role-user-avatar">{account.name.split(' ').map(part => part[0]).join('').slice(0,2)}</span><span className="role-user-info"><strong>{account.name}</strong><small>{account.email}</small></span><StatusPill status={account.active ? 'ACTIVE' : 'OFFLINE'} label={account.active ? 'Active' : 'Inactive'} /><select value={account.role} onChange={e => void changeRole(account, e.target.value)} aria-label={`Change ${account.name} role`}>{roleOptions.map(role => <option key={role}>{role}</option>)}</select></div>)}</div></section>}
+    </div><aside className="settings-side-column"><section className="panel settings-status-card"><div className="settings-status-head"><span className="settings-icon settings-icon-green"><ShieldCheck size={17} /></span><span className="settings-side-check"><Check size={13} />ACTIVE</span></div><span className="panel-kicker">CAMPUSIQ DEFAULTS</span><h3>Privacy commitments</h3><div className="settings-check-list"><span><Check size={14} />No facial recognition</span><span><Check size={14} />No identity tracking</span><span><Check size={14} />Role-based API permissions</span><span><Check size={14} />Secure source credentials</span><span><Check size={14} />Demo data clearly labelled</span></div></section><section className="panel settings-demo-card"><span className="settings-icon settings-icon-amber"><BellRing size={17} /></span><span className="panel-kicker">DEMO ENVIRONMENT</span><h3>Sample campus data</h3><p>All numbers and events in this environment are fictional and generated for demonstration.</p><div className="settings-data-badge"><span />{settings.dataLabel}</div></section><div className="settings-help-note"><LockKeyhole size={14} /><span>Production deployments should use institution-managed SSO, approved camera notices, limited access roles, encrypted secrets and a documented deletion policy.</span></div></aside></div>
+    {showPassword && <Modal title="Demo account access" description="This workspace uses passwordless demo access." onClose={() => setShowPassword(false)}><div className="demo-account-modal"><ShieldCheck size={22} /><p>No real password is stored for this sample account. Sign out and select an institution account to use password management.</p><Button onClick={() => setShowPassword(false)}>Got it</Button></div></Modal>}
+  </div>
+}
