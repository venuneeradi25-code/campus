+import { useMemo, useState } from 'react'
+import { ArrowRight, BookOpen, Building2, CheckCircle2, CircleAlert, Clock3, Download, Search, Users2, X } from 'lucide-react'
+import type { Room } from '../types'
+import { useCampus } from '../context/CampusContext'
+import { formatNumber, PageHeading, StatusPill } from '../components/Primitives'
+import { Modal } from '../components/Modal'
+
+const roomStatusFilter = ['ALL', 'ACTIVE', 'AVAILABLE', 'OVER CAPACITY', 'SCHEDULED - INACTIVE']
+export function ClassroomsPage({ onPage }: { onPage: (key: 'assistant') => void }) {
+  const { snapshot } = useCampus()
+  const [query, setQuery] = useState('')
+  const [status, setStatus] = useState('ALL')
+  const [department, setDepartment] = useState('ALL')
+  const [selected, setSelected] = useState<Room | null>(null)
+  const rooms = snapshot!.classrooms
+  const departments = [...new Set(rooms.map(room => room.department))].sort()
+  const filtered = useMemo(() => rooms.filter(room => {
+    const matchesSearch = `${room.name} ${room.department} ${room.scheduledClass} ${room.buildingId}`.toLowerCase().includes(query.toLowerCase())
+    return matchesSearch && (status === 'ALL' || room.status === status) && (department === 'ALL' || room.department === department)
+  }), [rooms, query, status, department])
+  const active = rooms.filter(room => room.status === 'ACTIVE' || room.status === 'OVER CAPACITY').length
+  const available = rooms.filter(room => room.occupancy === 0 && room.status === 'AVAILABLE').length
+  const overcrowded = rooms.filter(room => room.status === 'OVER CAPACITY').length
+  const inactive = rooms.filter(room => room.status === 'SCHEDULED - INACTIVE').length
+  return <div className="page-content">
+    <PageHeading eyebrow="LIVE OPERATIONS / LEARNING SPACES" title="Classroom monitoring" description="See what is in session, what is available and where attention may be needed."><button className="btn btn-secondary" onClick={() => onPage('assistant')}><SparkIcon />Ask for a room</button><button className="btn btn-primary" onClick={() => window.print()}><Download size={15} />Print room list</button></PageHeading>
+    <div className="classroom-stats-grid"><ClassStat icon={<BookOpen size={17} />} label="Active spaces" value={active} detail="classes in session" tone="green" /><ClassStat icon={<CheckCircle2 size={17} />} label="Available now" value={available} detail="unoccupied spaces" tone="blue" /><ClassStat icon={<CircleAlert size={17} />} label="Over capacity" value={overcrowded} detail="needs a quick check" tone="red" /><ClassStat icon={<Clock3 size={17} />} label="Scheduled · inactive" value={inactive} detail="class expected · no activity" tone="amber" /></div>
+    <section className="panel rooms-table-panel"><div className="rooms-toolbar"><div><div className="panel-kicker">ROOM OCCUPANCY / {rooms.length} SPACES TRACKED</div><h2>All monitored spaces</h2><p>Anonymous counts update from in-room cameras and schedules.</p></div><div className="room-table-filters"><label className="room-search"><Search size={16} /><input value={query} onChange={e => setQuery(e.target.value)} placeholder="Search rooms, courses…" /><kbd>⌕</kbd></label><select value={department} onChange={e => setDepartment(e.target.value)}><option value="ALL">All departments</option>{departments.map(item => <option key={item}>{item}</option>)}</select></div></div>
+      <div className="room-filter-tabs">{roomStatusFilter.map(item => <button key={item} className={status === item ? 'selected' : ''} onClick={() => setStatus(item)}>{item === 'ALL' ? 'All rooms' : item === 'SCHEDULED - INACTIVE' ? 'Scheduled · inactive' : item.toLowerCase().replace(/\b\w/g, c => c.toUpperCase())}{item === 'ALL' && <span>{rooms.length}</span>}</button>)}</div>
+      <div className="table-scroll"><table className="data-table room-data-table"><thead><tr><th>ROOM</th><th>DEPARTMENT</th><th>CAPACITY</th><th>LIVE OCCUPANCY</th><th>SCHEDULE</th><th>FACULTY</th><th>STATUS</th><th /></tr></thead><tbody>{filtered.map(room => <tr key={room.id} onClick={() => setSelected(room)} className="clickable-row"><td><span className="room-name-cell"><span className={`room-square ${room.type === 'Laboratory' ? 'room-square-lab' : ''}`}><Building2 size={14} /></span><span><strong>{room.name}</strong><small>{buildingLabel(room.buildingId)} · Floor {room.floor}</small></span></span></td><td>{room.department}</td><td><span className="room-capacity"><Users2 size={14} />{room.capacity}</span></td><td><div className="room-occupancy-cell"><div className="room-occupancy-numbers"><strong>{room.occupancy}</strong><span> / {room.capacity}</span><em>{room.occupancyPercent}%</em></div><div className="room-mini-progress"><i className={room.occupancyPercent >= 95 ? 'over' : room.occupancyPercent >= 80 ? 'high' : ''} style={{ width: `${Math.min(room.occupancyPercent, 100)}%` }} /></div></div></td><td><span className="room-schedule"><strong>{room.scheduledClass === '—' ? 'No class' : room.scheduledClass}</strong><small>{room.startsAt !== '—' ? `${room.startsAt} – ${room.endsAt}` : 'Open access'}</small></span></td><td><span className={`faculty-status ${room.facultyStatus === 'Present' ? 'faculty-present' : room.facultyStatus === 'Not detected' ? 'faculty-missing' : ''}`}><i />{room.facultyStatus}</span></td><td><StatusPill status={room.status} label={room.status.toLowerCase().replace(/\b\w/g, c => c.toUpperCase())} /></td><td><button className="table-chevron" aria-label={`View ${room.name}`}><ArrowRight size={15} /></button></td></tr>)}</tbody></table>{!filtered.length && <div className="table-empty"><Search size={20} /><strong>No rooms found</strong><span>Try a different search or filter.</span></div>}</div>
+      <div className="table-footer"><span>Showing <strong>{filtered.length}</strong> of {rooms.length} monitored spaces</span><span><span className="table-live-dot" />Live occupancy · refreshed every 5s</span></div>
+    </section>
+    <div className="room-privacy-banner"><span><Users2 size={16} /></span><div><strong>Counts, not identities</strong><small>Room occupancy is estimated anonymously. Faculty status is a non-biometric presence signal, not a person identifier.</small></div></div>
+    {selected && <RoomModal room={selected} onClose={() => setSelected(null)} />}
+  </div>
+}
+function ClassStat({ icon, label, value, detail, tone }: { icon: React.ReactNode; label: string; value: number; detail: string; tone: string }) { return <div className={`panel class-stat class-stat-${tone}`}><div className="class-stat-icon">{icon}</div><span>{label}</span><strong>{formatNumber(value)}</strong><small>{detail}</small></div> }
+function buildingLabel(id: string) { return ({ 'main': 'Main Block', 'cse': 'CSE Block', 'ai-ds': 'AI & DS Block', 'library': 'Library', 'auditorium': 'Auditorium', 'labs': 'Innovation Labs', 'sports': 'Sports Complex' } as Record<string, string>)[id] ?? id }
+function RoomModal({ room, onClose }: { room: Room; onClose: () => void }) { return <Modal title={`${room.name} · room profile`} description="Live anonymous occupancy and schedule status." onClose={onClose}><div className="room-modal-body"><div className="room-modal-occupancy"><span>LIVE OCCUPANCY</span><strong>{room.occupancy}<small> / {room.capacity}</small></strong><div className="room-modal-progress"><i style={{ width: `${Math.min(100, room.occupancyPercent)}%` }} /></div><em>{room.occupancyPercent}% of room capacity</em></div><div className="room-modal-detail-grid"><span><small>Department</small><strong>{room.department}</strong></span><span><small>Building & floor</small><strong>{buildingLabel(room.buildingId)} · {room.floor}</strong></span><span><small>Scheduled class</small><strong>{room.scheduledClass}</strong></span><span><small>Faculty signal</small><strong>{room.facultyStatus}</strong></span></div><div className="room-modal-status"><StatusPill status={room.status} label={room.status} /><span>{room.startsAt === '—' ? 'No scheduled class' : `${room.startsAt} – ${room.endsAt}`}</span></div></div></Modal> }
+function SparkIcon() { return <span className="sparkle-glyph">✦</span> }
