+async def infer_image(content: bytes, filename: str = "campus-frame.jpg", content_type: str = "image/jpeg") -> dict:
+    if AI_SERVICE_URL:
+        try:
+            async with httpx.AsyncClient(timeout=45) as client:
+                response = await client.post(f"{AI_SERVICE_URL}/infer/image", files={"file": (filename, content, content_type)})
+            if response.status_code >= 400:
+                detail = response.json().get("detail", "The AI inference service rejected this image.")
+                raise VisionError(str(detail))
+            return response.json()
+        except httpx.RequestError:
+            # Keep local OpenCV counting available if the isolated worker is temporarily offline.
+            pass
+    return await run_in_threadpool(vision_engine.analyze_image, content)
+
+
+async def infer_video(path: str, content: bytes, filename: str, content_type: str, sample_seconds: float) -> dict:
+    if AI_SERVICE_URL:
+        try:
+            async with httpx.AsyncClient(timeout=300) as client:
+                response = await client.post(f"{AI_SERVICE_URL}/infer/video", files={"file": (filename, content, content_type)}, data={"sample_seconds": sample_seconds})
+            if response.status_code >= 400:
+                detail = response.json().get("detail", "The AI inference service could not process this video.")
+                raise VisionError(str(detail))
+            return response.json()
+        except httpx.RequestError:
+            # Retain a local fallback so camera uploads keep working in demo deployments.
+            pass
+    return await run_in_threadpool(vision_engine.analyze_video, path, sample_seconds)
