+    slot = db.get(ParkingSlot, slot_id)
+    if not slot:
+        raise HTTPException(status_code=404, detail="Parking slot not found.")
+    zone = db.get(ParkingZone, slot.zone_id)
+    old = slot.state
+    old_vehicle = slot.vehicle_type
+    slot.state = body.state
+    if body.state == "OCCUPIED" and not slot.vehicle_type:
+        slot.vehicle_type = "BIKE" if zone.category == "TWO-WHEELER" else "CAR"
+    if body.state != "OCCUPIED":
+        slot.vehicle_type = None
+    if old != body.state:
+        if old == "OCCUPIED":
+            zone.occupied_slots = max(0, zone.occupied_slots - 1)
+            if old_vehicle == "BIKE":
+                zone.bikes = max(0, zone.bikes - 1)
+            elif old_vehicle == "CAR":
+                zone.cars = max(0, zone.cars - 1)
+        if body.state == "OCCUPIED":
+            zone.occupied_slots += 1
+            if slot.vehicle_type == "BIKE":
+                zone.bikes += 1
+            elif slot.vehicle_type == "CAR":
+                zone.cars += 1
+        if old == "RESERVED":
+            zone.reserved_slots = max(0, zone.reserved_slots - 1)
+        if body.state == "RESERVED":
+            zone.reserved_slots += 1
+        if old == "DISABLED":
+            zone.disabled_slots = max(0, zone.disabled_slots - 1)
+        if body.state == "DISABLED":
+            zone.disabled_slots += 1
+    db.commit()
