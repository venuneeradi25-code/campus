+@app.post("/api/auth/login")
+def login(body: dict[str, str], db: Session = Depends(get_db)):
+    email = body.get("email", "").strip().lower()
+    password = body.get("password", "")
+    user = db.query(User).filter(User.email == email, User.active.is_(True)).first()
+    if not user or not user.password_hash or not password:
+        raise HTTPException(status_code=401, detail="Email or password is incorrect. If you are demonstrating CampusIQ, use the secure demo sign-in.")
+    try:
+        _, salt, expected = user.password_hash.split("$", 2)
+        actual = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 180_000).hex()
+        valid = hmac.compare_digest(actual, expected)
+    except Exception:
+        valid = False
+    if not valid:
+        raise HTTPException(status_code=401, detail="Email or password is incorrect.")
+    return {"accessToken": token_for(user.id, user.email, user.display_name, user.role_name), "tokenType": "bearer", "user": {"id": user.id, "email": user.email, "name": user.display_name, "role": user.role_name, "demo": False}}
