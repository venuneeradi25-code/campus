+        camera.last_updated = utcnow()
+        db.commit()
+        return {"ok": True, "message": "The last clip was analyzed and discarded; upload a new clip to run another anonymous sample."}
+    try:
+        if not camera.source_uri:
+            raise VisionError("No RTSP source is configured on the backend.")
+        result = vision_engine.analyze_stream(reveal_camera_source(camera.source_uri) or "")
+        camera.status, camera.stream_active, camera.fps = "ONLINE", True, 15
+        camera.people_count, camera.vehicle_count = int(result["people"]), int(result["vehicles"])
+        camera.last_updated = utcnow()
