@@ -0,0 +1,17 @@
+import type { ReactNode } from 'react'
+import { ArrowDownRight, ArrowUpRight, Minus } from 'lucide-react'
+
+export function MetricCard({ label, value, detail, delta, icon, accent = 'mint', sparkline }: {
+  label: string; value: string | number; detail?: string; delta?: { value: string; trend: 'up' | 'down' | 'flat' }
+  icon: ReactNode; accent?: 'mint' | 'blue' | 'amber' | 'violet' | 'rose'; sparkline?: number[]
+}) {
+  const values = sparkline ?? [28, 35, 31, 48, 41, 54, 50, 69, 62, 78]
+  const max = Math.max(...values), min = Math.min(...values)
+  const points = values.map((v, i) => `${(i / (values.length - 1)) * 72},${26 - ((v - min) / Math.max(max - min, 1)) * 21}`).join(' ')
+  const TrendIcon = delta?.trend === 'down' ? ArrowDownRight : delta?.trend === 'flat' ? Minus : ArrowUpRight
+  return <article className={`metric-card metric-${accent}`}>
+    <div className="metric-card-top"><div className="metric-icon">{icon}</div>{delta && <span className={`metric-delta delta-${delta.trend}`}><TrendIcon size={13} />{delta.value}</span>}</div>
+    <div className="metric-card-value-row"><div className="metric-value">{value}</div>{sparkline && <svg className="metric-sparkline" viewBox="0 0 72 28" aria-hidden="true"><polyline points={points} fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" /><circle cx={points.split(' ').at(-1)?.split(',')[0]} cy={points.split(' ').at(-1)?.split(',')[1]} r="2.6" fill="currentColor" /></svg>}</div>
+    <div className="metric-label">{label}</div>{detail && <div className="metric-detail">{detail}</div>}
+  </article>
+}
