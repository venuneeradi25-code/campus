+export type NavKey = 'overview' | 'cameras' | 'twin' | 'classrooms' | 'events' | 'parking' | 'facilities' | 'analytics' | 'alerts' | 'assistant' | 'resources' | 'health' | 'settings'
+export type Role = 'SUPER ADMIN' | 'CAMPUS ADMIN' | 'SECURITY ADMIN' | 'EVENT ADMIN'
+
+export interface Metrics {
+  students: number; staff: number; visitors: number; population: number; campusOccupancy: number
+  activeClasses: number; freeClassrooms: number; entries: number; exits: number; peakPopulation: number
+  activeEvents: number; activeAlerts: number; onlineCameras: number; totalCameras: number
+  parkingTotal: number; parkingOccupied: number; parkingAvailable: number; parkingReserved: number
+  parkingDisabled: number; parkingOccupancy: number; cars: number; bikes: number
+}
+export interface Building {
+  id: string; name: string; category: string; floors: number; capacity: number; population: number; staff: number
+  occupancyPercent: number; status: string; classrooms: number; activeClasses: number; emptyRooms: number
+  availableResources: number; alerts: number; mapX: number; mapY: number
+}
+export interface Room {
+  id: string; name: string; buildingId: string; department: string; type: string; floor: number; capacity: number
+  occupancy: number; occupancyPercent: number; scheduledClass: string; facultyStatus: string; status: string
+  startsAt: string; endsAt: string
+}
+export interface Camera {
+  id: string; name: string; location: string; buildingId: string; sourceType: string; hasSource: boolean
+  status: string; fps: number; aiEnabled: boolean; streamActive: boolean; lastUpdated: string
+  peopleCount: number; vehicleCount: number
+}
+export interface Slot { id: string; label: string; state: 'AVAILABLE' | 'OCCUPIED' | 'RESERVED' | 'DISABLED'; vehicleType: string | null }
+export interface ParkingZone {
+  id: string; name: string; category: string; total: number; occupied: number; available: number; reserved: number
+  disabled: number; occupancyPercent: number; cars: number; bikes: number; slots: Slot[]
+}
+export interface Parking {
+  total: number; occupied: number; available: number; reserved: number; disabled: number; occupancyPercent: number
+  cars: number; bikes: number; zones: ParkingZone[]; recentUsage?: { label: string; occupied: number }[]
+}
+export interface CampusEvent {
+  id: string; name: string; venue: string; buildingId: string; startTime: string; endTime: string; capacity: number
+  expectedCrowd: number; currentCrowd: number; occupancyPercent: number; status: string; category: string
+}
+export interface Alert {
+  id: string; type: string; title: string; location: string; buildingId: string | null; severity: string
+  description: string; status: string; timestamp: string
+}
+export interface Facility {
+  id: string; name: string; type: string; buildingId: string; capacity: number; occupancy: number
+  occupancyPercent: number; isOpen: boolean; peakUsage: string; status: string
+}
+export interface Resource { id: string; name: string; category: string; buildingId: string; status: string; quantity: number; detail: string }
+export interface Snapshot {
+  timestamp: string; demoActive: boolean; metrics: Metrics; buildings: Building[]; classrooms: Room[]; rooms: Room[]
+  cameras: Camera[]; parking: Parking; events: CampusEvent[]; alerts: Alert[]; facilities: Facility[]; resources: Resource[]
+}
+export interface AnalyticsData {
+  range: string; generatedAt: string
+  population: { label: string; population: number; students: number; staff: number; visitors: number; peak: number; entries: number; exits: number }[]
+  hourly: { label: string; population: number; classrooms: number; library: number; parking: number }[]
+  buildings: { name: string; occupancy: number; population: number }[]
+  classroomUtilization: { name: string; department: string; occupancy: number; capacity: number; people: number }[]
+  parkingZones: { name: string; occupied: number; available: number; occupancy: number }[]
+  cameras: { id: string; name: string; online: boolean; detections: number; fps: number }[]
+  summary: { peakPopulation: number; avgCampusOccupancy: number; classroomUtilization: number; parkingUtilization: number }
+}
+export interface AuthUser { id: string; email: string; name: string; role: Role; demo: boolean }
