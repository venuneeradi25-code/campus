+def build_analytics(db: Session, period: str = "24h", start: datetime | None = None, end: datetime | None = None) -> dict:
+    now = utcnow()
+    if start and end:
+        start_at, end_at = start, end
+        label = "custom"
+    elif period == "yesterday":
+        start_at = (now - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
+        end_at = now.replace(hour=0, minute=0, second=0, microsecond=0)
+        label = period
+    else:
+        days = {"24h": 1, "today": 1, "7d": 7, "30d": 30}.get(period, 1)
+        start_at, end_at = now - timedelta(days=days), now
+        label = "24h" if period == "today" else period
+    metrics = db.query(CampusMetric).filter(CampusMetric.timestamp >= start_at, CampusMetric.timestamp <= end_at).order_by(CampusMetric.timestamp.asc()).all()
+    if not metrics:
+        metrics = db.query(CampusMetric).order_by(CampusMetric.timestamp.desc()).limit(24).all()[::-1]
+    bucketed: dict[str, list[CampusMetric]] = {}
+    for row in metrics:
+        dt = row.timestamp
+        if label in {"24h", "today", "yesterday"}:
+            key = dt.strftime("%H:00")
+        else:
+            key = dt.strftime("%b %d")
+        bucketed.setdefault(key, []).append(row)
+    population = []
+    for key, rows in bucketed.items():
+        average = round(sum(r.population for r in rows) / len(rows))
+        population.append({"label": key, "population": average, "students": round(sum(r.students for r in rows) / len(rows)), "staff": round(sum(r.staff for r in rows) / len(rows)), "visitors": round(sum(r.visitors for r in rows) / len(rows)), "peak": max(r.peak_population for r in rows), "entries": sum(r.entries for r in rows), "exits": sum(r.exits for r in rows)})
+    if len(population) > 60:
+        step = math.ceil(len(population) / 60)
+        population = population[::step]
+    buildings = db.query(Building).all()
+    rooms = db.query(Room).filter(Room.room_type == "Classroom").all()
+    zones = db.query(ParkingZone).all()
+    cameras = db.query(Camera).all()
+    # Stable illustrative hourly series supplement the live population history.
+    hours = []
+    for hour in range(6, 22):
+        peak = max(0, math.sin((hour - 6) / 16 * math.pi))
+        hours.append({"label": f"{hour:02d}:00", "population": int(420 + peak * 3950), "classrooms": round(24 + peak * 63), "library": round(18 + peak * 61), "parking": round(25 + peak * 59)})
+    return {
+        "range": label,
+        "generatedAt": stamp(now),
+        "population": population,
+        "hourly": hours,
+        "buildings": [{"name": b.name.replace(" Block", ""), "occupancy": b.occupancy_percent, "population": b.population} for b in buildings if b.id != "parking"],
+        "classroomUtilization": [{"name": r.name, "department": r.department, "occupancy": round(r.occupancy / max(r.capacity, 1) * 100), "capacity": r.capacity, "people": r.occupancy} for r in rooms],
+        "parkingZones": [{"name": z.name.replace(" Parking", ""), "occupied": z.occupied_slots, "available": z.total_slots - z.occupied_slots - z.reserved_slots - z.disabled_slots, "occupancy": round(z.occupied_slots / max(z.total_slots, 1) * 100)} for z in zones],
+        "cameras": [{"id": c.id, "name": c.name, "online": c.status == "ONLINE", "detections": c.people_count + c.vehicle_count, "fps": c.fps} for c in cameras],
+        "summary": {"peakPopulation": max((r.population for r in metrics), default=0), "avgCampusOccupancy": round(sum(b.occupancy_percent for b in buildings if b.id != "parking") / max(len(buildings) - 1, 1), 1), "classroomUtilization": round(sum(r.occupancy for r in rooms) / max(sum(r.capacity for r in rooms), 1) * 100, 1), "parkingUtilization": round(sum(z.occupied_slots for z in zones) / max(sum(z.total_slots for z in zones), 1) * 100, 1)},
+    }
