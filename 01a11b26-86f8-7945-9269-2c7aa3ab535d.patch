+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+try:
+    from app import database, main
+    from app.models import Camera
+    from app.security import reveal_camera_source
+except ModuleNotFoundError:
+    from backend.app import database, main
+    from backend.app.models import Camera
+    from backend.app.security import reveal_camera_source
+
+
+@pytest.fixture()
+def client(tmp_path, monkeypatch):
+    engine = create_engine(f"sqlite:///{tmp_path / 'campusiq-test.db'}", connect_args={"check_same_thread": False})
+    session_factory = sessionmaker(bind=engine, autoflush=False, expire_on_commit=False)
+    monkeypatch.setattr(database, "engine", engine)
+    monkeypatch.setattr(database, "SessionLocal", session_factory)
+    monkeypatch.setattr(main, "SessionLocal", session_factory)
+    monkeypatch.setattr(main, "DEMO_ALLOWED", True)
+    with TestClient(main.app) as test_client:
+        yield test_client
+    engine.dispose()
+
+
+def token_for(client: TestClient, role: str = "SUPER ADMIN") -> str:
+    response = client.post("/api/auth/demo", json={"role": role})
+    assert response.status_code == 200
+    token = response.json()["accessToken"]
+    assert token.count(".") == 2  # compact HS256 JWT
+    return token
+
+
+def auth(token: str) -> dict[str, str]:
+    return {"Authorization": f"Bearer {token}"}
+
+
+def test_snapshot_is_seeded_with_privacy_safe_live_data(client):
+    token = token_for(client)
+    response = client.get("/api/snapshot", headers=auth(token))
+    assert response.status_code == 200
+    data = response.json()
+    assert data["metrics"]["students"] > 3000
+    assert data["metrics"]["onlineCameras"] >= 5
+    assert len(data["parking"]["zones"]) == 4
+    assert any(room["name"] == "AI-204" for room in data["classrooms"])
+    assert all("sourceUri" not in camera for camera in data["cameras"])
+    assert len(client.get("/api/floors", headers=auth(token)).json()) > 10
+
+
+def test_local_assistant_answers_from_current_classroom_data(client):
+    token = token_for(client)
+    response = client.post("/api/assistant/ask", headers=auth(token), json={"question": "Which classrooms are available for 50 students?"})
+    assert response.status_code == 200
+    payload = response.json()
+    assert "AI-206" in payload["answer"]
+    assert payload["sources"]
+    assert "no individual identities" in payload["privacy"].lower()
+
+
+def test_event_spike_creates_capacity_alert(client):
+    token = token_for(client)
+    response = client.post("/api/events/event-technova/simulate-spike", headers=auth(token))
+    assert response.status_code == 200
+    assert response.json()["event"]["occupancyPercent"] >= 90
+    alerts = client.get("/api/alerts?status=ACTIVE", headers=auth(token)).json()
+    assert any("TECHNOVA" in alert["title"] for alert in alerts)
+
+
+def test_camera_source_credentials_never_appear_in_response(client):
+    token = token_for(client)
+    response = client.post("/api/cameras", headers=auth(token), json={
+        "name": "Secure RTSP demo", "location": "Main Block · east", "building_id": "main",
+        "source_type": "RTSP", "source_uri": "rtsp://user:secret@example.invalid/live",
+    })
+    assert response.status_code == 200
+    assert response.json()["hasSource"] is True
+    assert "secret" not in response.text
+    assert "sourceUri" not in response.text
+    db = database.SessionLocal()
+    try:
+        stored = db.get(Camera, response.json()["id"])
+        assert stored and stored.source_uri and stored.source_uri.startswith("enc:v1:")
+        assert "secret" not in stored.source_uri
+    finally:
+        db.close()
+    # Switching away from RTSP clears the encrypted source; demo sources cannot store credentials.
+    changed = client.patch(f"/api/cameras/{response.json()['id']}", headers=auth(token), json={"source_type": "DEMO"})
+    assert changed.status_code == 200 and changed.json()["hasSource"] is False
+    rejected = client.post("/api/cameras", headers=auth(token), json={
+        "name": "Plaintext rejected", "location": "Main Block · west", "building_id": "main",
+        "source_type": "DEMO", "source_uri": "rtsp://user:secret@example.invalid/live",
+    })
+    assert rejected.status_code == 422 and "secret" not in rejected.text
+
+
+def test_legacy_rtsp_sources_are_migrated_to_encrypted_storage(client):
+    token_for(client)
+    db = database.SessionLocal()
+    try:
+        camera = db.get(Camera, "CAM-001")
+        camera.source_type = "RTSP"
+        camera.source_uri = "rtsp://legacy-user:legacy-secret@example.invalid/live"
+        db.commit()
+        assert main.encrypt_legacy_camera_sources(db) == 1
+        stored = db.get(Camera, "CAM-001")
+        assert stored.source_uri and stored.source_uri.startswith("enc:v1:")
+        assert "legacy-secret" not in stored.source_uri
+        assert reveal_camera_source(stored.source_uri) == "rtsp://legacy-user:legacy-secret@example.invalid/live"
+        assert main.encrypt_legacy_camera_sources(db) == 0
+    finally:
+        db.close()
+
+
+def test_uploaded_video_is_processed_from_temporary_storage_and_discarded(client, monkeypatch):
+    token = token_for(client)
+    original_tempfile = main.tempfile.NamedTemporaryFile
+    temp_paths: list[str] = []
+
+    def track_tempfile(*args, **kwargs):
+        handle = original_tempfile(*args, **kwargs)
+        temp_paths.append(handle.name)
+        return handle
+
+    monkeypatch.setattr(main.tempfile, "NamedTemporaryFile", track_tempfile)
+    monkeypatch.setattr(main, "AI_SERVICE_URL", "")
+    response = client.post("/api/cameras/CAM-001/upload", headers=auth(token),
+                           data={"sample_seconds": "1"},
+                           files={"file": ("private-campus-clip.avi", b"not a real video", "video/x-msvideo")})
+    assert response.status_code == 200
+    payload = response.json()
+    assert payload["camera"]["sourceType"] == "VIDEO"
+    assert payload["camera"]["hasSource"] is False
+    assert "private-campus-clip" not in response.text
+    assert temp_paths and all(not Path(path).exists() for path in temp_paths)
+
+
+def test_detection_ingest_and_vehicle_api_are_aggregate_only(client):
+    token = token_for(client)
+    detected = client.post("/api/detections/ingest", headers=auth(token), json={
+        "camera_id": "CAM-001", "people_count": 13, "vehicle_count": 2, "confidence": 0.86,
+    })
+    assert detected.status_code == 200
+    assert detected.json()["peopleCount"] == 13
+    assert "identity" in detected.json()["privacy"]
+    events = client.get("/api/detections?camera_id=CAM-001", headers=auth(token)).json()
+    assert any(event["peopleCount"] == 13 for event in events)
+    vehicles = client.get("/api/vehicles", headers=auth(token)).json()
+    assert vehicles["current"]["total"] > 0
+    assert "plates" in vehicles["privacy"]
+
+
+def test_role_permissions_are_enforced_on_camera_write(client):
+    token = token_for(client, "EVENT ADMIN")
+    response = client.post("/api/cameras", headers=auth(token), json={
+        "name": "Not permitted", "location": "Hall", "building_id": "main", "source_type": "DEMO",
+    })
+    assert response.status_code == 403
+
+
+def test_parking_slots_and_alert_actions_persist(client):
+    token = token_for(client)
+    snapshot = client.get("/api/snapshot", headers=auth(token)).json()
+    zone = snapshot["parking"]["zones"][0]
+    slot = next(slot for slot in zone["slots"] if slot["state"] == "AVAILABLE")
+    updated = client.patch(f"/api/parking/slots/{slot['id']}", headers=auth(token), json={"state": "OCCUPIED"})
+    assert updated.status_code == 200
+    assert updated.json()["slot"]["state"] == "OCCUPIED"
+    alert = client.get("/api/alerts?status=ACTIVE", headers=auth(token)).json()[0]
+    changed = client.patch(f"/api/alerts/{alert['id']}", headers=auth(token), json={"status": "ACKNOWLEDGED"})
+    assert changed.status_code == 200
+    assert changed.json()["status"] == "ACKNOWLEDGED"
+
+
+def test_analytics_csv_and_restricted_zone_demo(client):
+    token = token_for(client)
+    analytics = client.get("/api/analytics?period=7d", headers=auth(token))
+    assert analytics.status_code == 200
+    assert analytics.json()["population"]
+    csv = client.get("/api/analytics/export?period=7d", headers=auth(token))
+    assert csv.status_code == 200 and "text/csv" in csv.headers["content-type"]
+    zones = client.get("/api/restricted-zones", headers=auth(token)).json()
+    alert = client.post(f"/api/restricted-zones/{zones[0]['id']}/simulate-entry", headers=auth(token))
+    assert alert.status_code == 200
+    assert alert.json()["type"] == "RESTRICTED_AREA"
+
+
+def test_websocket_requires_auth_and_starts_with_aggregate_snapshot(client):
+    token = token_for(client)
+    with pytest.raises(Exception):
+        with client.websocket_connect("/ws/live"):
+            pass
+    with client.websocket_connect("/ws/live", subprotocols=["campusiq", f"bearer.{token}"]) as websocket:
+        assert websocket.accepted_subprotocol == "campusiq"
+        packet = websocket.receive_json()
+        assert packet["type"] == "snapshot"
+        assert packet["payload"]["metrics"]["population"] > 0
