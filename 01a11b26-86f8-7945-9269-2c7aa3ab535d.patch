+@app.post("/api/cameras/{camera_id}/upload")
+async def upload_camera_video(camera_id: str, file: UploadFile = File(...), sample_seconds: float = Form(1.0), user: dict = Depends(require_roles("SUPER ADMIN", "SECURITY ADMIN")), db: Session = Depends(get_db)):
+    camera = db.get(Camera, camera_id)
+    if not camera:
+        raise HTTPException(status_code=404, detail="Camera not found.")
+    if not file.content_type or not file.content_type.startswith("video/"):
+        raise HTTPException(status_code=415, detail="Choose a video file such as MP4, MOV, or AVI.")
+    content = await file.read(MAX_UPLOAD_MB * 1024 * 1024 + 1)
+    if len(content) > MAX_UPLOAD_MB * 1024 * 1024:
+        raise HTTPException(status_code=413, detail=f"Video exceeds the {MAX_UPLOAD_MB} MB upload limit.")
+    safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", Path(file.filename or "feed.mp4").name)
+    suffix = Path(safe_name).suffix[:12] or ".mp4"
+    temp_path: str | None = None
+    try:
+        with tempfile.NamedTemporaryFile(prefix=f"{camera.id}-", suffix=suffix, delete=False) as temp:
+            temp.write(content)
+            temp_path = temp.name
+        camera.source_type = "VIDEO"
+        camera.source_uri = None
+        camera.status, camera.stream_active = "ONLINE", True
+        camera.last_updated = utcnow()
+        try:
+            analysis = await infer_video(temp_path, content, safe_name, file.content_type, sample_seconds)
+        except VisionError as exc:
+            analysis = {"status": "uploaded", "message": str(exc), "sampled_frames": 0, "privacy": "No identity tracking is used."}
+        except Exception as exc:
+            print(f"CampusIQ video inference warning: {exc}")
+            analysis = {"status": "uploaded", "message": "The AI engine could not process this clip. Try an MP4 or MOV file.", "sampled_frames": 0, "privacy": "No identity tracking is used."}
+        if analysis.get("average_people") is not None:
+            camera.people_count = int(analysis["average_people"])
+            camera.vehicle_count = int(analysis.get("average_vehicles", 0))
+        db.add(CameraEvent(id=new_id("ce"), camera_id=camera.id, event_type="VIDEO_UPLOAD", people_count=camera.people_count, vehicle_count=camera.vehicle_count, confidence=float(analysis.get("mean_confidence", 0)), recorded_at=utcnow(), metadata_json={"source": "UPLOAD", "sampled_frames": analysis.get("sampled_frames", 0)}))
+        db.commit()
+        return {"camera": camera_payload(camera), "analysis": analysis}
+    finally:
+        if temp_path:
+            Path(temp_path).unlink(missing_ok=True)
+
