@@ -0,0 +1,84 @@
+import { createContext, useContext, useEffect, useMemo, useState } from 'react'
+import type { ReactNode } from 'react'
+import type { AuthUser, Role } from '../types'
+import { api } from '../services/api'
+
+type AuthValue = {
+  user: AuthUser | null
+  loading: boolean
+  error: string | null
+  signInDemo: (role: Role) => Promise<void>
+  signIn: (email: string, password: string) => Promise<void>
+  signOut: () => void
+}
+const AuthContext = createContext<AuthValue | null>(null)
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [user, setUser] = useState<AuthUser | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState<string | null>(null)
+
+  const applySession = (session: { accessToken: string; user: AuthUser }) => {
+    localStorage.setItem('campusiq-token', session.accessToken)
+    setUser(session.user)
+    setError(null)
+  }
+
+  useEffect(() => {
+    let alive = true
+    async function bootstrap() {
+      const token = localStorage.getItem('campusiq-token')
+      if (token) {
+        try {
+          const profile = await api.me()
+          if (alive) setUser(profile)
+          if (alive) { setLoading(false); return }
+        } catch {
+          localStorage.removeItem('campusiq-token')
+        }
+      }
+      // The initial visit opens a one-click demo session so the command center is immediately explorable.
+      try {
+        const session = await api.demoLogin('SUPER ADMIN')
+        if (alive) applySession(session)
+      } catch (err) {
+        if (alive) setError(err instanceof Error ? err.message : 'Could not start a demo session.')
+      } finally {
+        if (alive) setLoading(false)
+      }
+    }
+    void bootstrap()
+    return () => { alive = false }
+  }, [])
+
+  useEffect(() => {
+    const handleUnauthorized = () => {
+      localStorage.removeItem('campusiq-token')
+      setUser(null)
+      setError('Your session expired. Sign in again to continue.')
+    }
+    window.addEventListener('campusiq:unauthorized', handleUnauthorized)
+    return () => window.removeEventListener('campusiq:unauthorized', handleUnauthorized)
+  }, [])
+
+  const signInDemo = async (role: Role) => {
+    const session = await api.demoLogin(role)
+    applySession(session)
+  }
+  const signIn = async (email: string, password: string) => {
+    const session = await api.login(email, password)
+    applySession(session)
+  }
+  const signOut = () => {
+    localStorage.removeItem('campusiq-token')
+    setUser(null)
+  }
+  const value = useMemo(() => ({ user, loading, error, signInDemo, signIn, signOut }), [user, loading, error])
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>
+}
+
+export function useAuth() {
+  const value = useContext(AuthContext)
+  if (!value) throw new Error('useAuth must be used inside AuthProvider')
+  return value
+}
