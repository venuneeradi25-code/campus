+def event_payload(event: CampusEvent) -> dict:
+    percentage = round(event.current_crowd / max(event.capacity, 1) * 100, 1)
+    if event.status not in {"COMPLETED", "CANCELLED"}:
+        if percentage >= 100:
+            status = "CAPACITY REACHED"
+        elif percentage >= 90:
+            status = "HIGH"
+        elif percentage >= 80:
+            status = "WARNING"
+        elif event.start_time <= utcnow() <= event.end_time:
+            status = "LIVE"
+        else:
+            status = event.status
+    else:
+        status = event.status
+    return {
+        "id": event.id, "name": event.name, "venue": event.venue,
+        "buildingId": event.building_id, "startTime": stamp(event.start_time),
+        "endTime": stamp(event.end_time), "capacity": event.capacity,
+        "expectedCrowd": event.expected_crowd, "currentCrowd": event.current_crowd,
+        "occupancyPercent": percentage, "status": status, "category": event.category,
+    }
