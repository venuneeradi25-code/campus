+"""Optional isolated inference worker for approved, anonymous camera analytics."""
+from __future__ import annotations
+
+import os
+import tempfile
+from pathlib import Path
+from fastapi import FastAPI, File, Form, HTTPException, UploadFile
+from starlette.concurrency import run_in_threadpool
+from backend.app.vision import VisionError, vision_engine
+
+app = FastAPI(title="CampusIQ AI inference", version="1.0.0", description="Anonymous people and vehicle counting. No identity inference.")
+MAX_UPLOAD_MB = int(os.getenv("MAX_UPLOAD_MB", "250"))
+
+
+@app.get("/health")
+def health():
+    return {"status": "healthy", "engine": vision_engine.status, "privacy": {"faceRecognition": False, "identityTracking": False}}
+
+
+@app.post("/infer/image")
+async def infer_image(file: UploadFile = File(...)):
+    if not file.content_type or not file.content_type.startswith("image/"):
+        raise HTTPException(status_code=415, detail="Expected an image upload.")
+    content = await file.read(15 * 1024 * 1024 + 1)
+    if len(content) > 15 * 1024 * 1024:
+        raise HTTPException(status_code=413, detail="Image exceeds the 15 MB limit.")
+    try:
+        return await run_in_threadpool(vision_engine.analyze_image, content)
+    except VisionError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+
+
+@app.post("/infer/video")
+async def infer_video(file: UploadFile = File(...), sample_seconds: float = Form(1.0)):
+    if not file.content_type or not file.content_type.startswith("video/"):
+        raise HTTPException(status_code=415, detail="Expected a video upload.")
+    content = await file.read(MAX_UPLOAD_MB * 1024 * 1024 + 1)
+    if len(content) > MAX_UPLOAD_MB * 1024 * 1024:
+        raise HTTPException(status_code=413, detail=f"Video exceeds the {MAX_UPLOAD_MB} MB limit.")
+    suffix = Path(file.filename or "campus-feed.mp4").suffix[:12] or ".mp4"
+    temp_path = None
+    try:
+        with tempfile.NamedTemporaryFile(prefix="campusiq-", suffix=suffix, delete=False) as temp:
+            temp.write(content)
+            temp_path = temp.name
+        return await run_in_threadpool(vision_engine.analyze_video, temp_path, sample_seconds)
+    except VisionError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    finally:
+        if temp_path:
+            Path(temp_path).unlink(missing_ok=True)
