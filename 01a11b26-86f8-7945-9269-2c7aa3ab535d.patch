+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    init_database()
+    db = SessionLocal()
+    try:
+        encrypt_legacy_camera_sources(db)
+        seed_database(db)
+    finally:
+        db.close()
+    task = asyncio.create_task(simulation_loop())
+    app.state.simulation_task = task
+    yield
+    task.cancel()
+    try:
+        await task
+    except asyncio.CancelledError:
+        pass
+
