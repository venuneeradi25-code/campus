+        <div className="twin-floor-select"><div className="floor-label"><Layers3 size={14} />FLOOR PLAN</div><div className="floor-tabs">{Array.from({ length: Math.min(selected.floors, 4) }, (_, i) => i + 1).map(value => <button key={value} className={floor === value ? 'selected' : ''} onClick={() => setFloor(value)}>{['1st','2nd','3rd','4th'][value - 1]}</button>)}</div></div>
+        <div className="floor-room-list"><div className="floor-room-heading"><span>Floor {floor} · spaces</span><span>{currentRooms.length || '—'} tracked</span></div>{currentRooms.length ? currentRooms.slice(0, 4).map(room => <div className="floor-room-row" key={room.id}><span className="floor-room-dot" /><span><strong>{room.name}</strong><small>{room.scheduledClass === '—' ? room.type : room.scheduledClass}</small></span><span>{room.occupancy}/{room.capacity}</span><small>{room.status === 'AVAILABLE' ? 'FREE' : room.status}</small></div>) : <div className="floor-no-rooms">No room-level sensors registered on this floor.</div>}</div>
