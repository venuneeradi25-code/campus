+@app.post("/api/cameras")
+def create_camera(body: CameraCreate, user: dict = Depends(require_roles("SUPER ADMIN", "SECURITY ADMIN")), db: Session = Depends(get_db)):
+    if not db.get(Building, body.building_id):
+        raise HTTPException(status_code=404, detail="Select a campus building that exists.")
+    source_uri = body.source_uri.strip() if body.source_uri else None
+    if body.source_type == "RTSP" and (not source_uri or not source_uri.lower().startswith("rtsp://")):
+        raise HTTPException(status_code=422, detail="An RTSP camera requires a valid rtsp:// source URL.")
+    if body.source_type != "RTSP" and source_uri:
+        raise HTTPException(status_code=422, detail="A source URL can only be configured for an RTSP camera.")
+    camera_num = max([int(re.sub(r"\D", "", c.id) or 0) for c in db.query(Camera).all()] + [0]) + 1
+    camera = Camera(id=f"CAM-{camera_num:03d}", name=body.name, location=body.location, building_id=body.building_id, source_type=body.source_type, source_uri=protect_camera_source(source_uri, body.source_type), status="ONLINE" if body.source_type == "DEMO" else "CONNECTING", fps=15 if body.source_type == "DEMO" else 0, ai_enabled=True, stream_active=True, last_updated=utcnow(), people_count=random.randint(1, 28))
+    db.add(camera)
