@@ -0,0 +1,32 @@
+"""Secrets helpers for private camera source configuration."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import os
+from cryptography.fernet import Fernet, InvalidToken
+
+_SECRET = os.getenv("CAMPUSIQ_SECRET_KEY", "campusiq-local-development-key-change-before-deploying").encode()
+_FERNET_KEY = base64.urlsafe_b64encode(hashlib.sha256(_SECRET + b"campusiq-camera-source-v1").digest())
+_FERNET = Fernet(_FERNET_KEY)
+_PREFIX = "enc:v1:"
+
+
+def protect_camera_source(value: str | None, source_type: str) -> str | None:
+    if not value:
+        return None
+    if source_type.upper() != "RTSP":
+        return value
+    return _PREFIX + _FERNET.encrypt(value.encode()).decode()
+
+
+def reveal_camera_source(value: str | None) -> str | None:
+    if not value:
+        return None
+    if not value.startswith(_PREFIX):
+        # Compatibility for a local pre-encryption development DB.
+        return value
+    try:
+        return _FERNET.decrypt(value[len(_PREFIX):].encode()).decode()
+    except InvalidToken as exc:
+        raise ValueError("Camera source could not be decrypted. Check that CAMPUSIQ_SECRET_KEY is unchanged.") from exc
