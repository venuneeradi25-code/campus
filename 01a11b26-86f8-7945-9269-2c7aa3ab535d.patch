+@app.websocket("/ws/live")
+async def live_updates(websocket: WebSocket):
+    offered = websocket.scope.get("subprotocols", [])
+    bearer_protocol = next((value for value in offered if value.startswith("bearer.")), None)
+    token = bearer_protocol.removeprefix("bearer.") if bearer_protocol else ""
+    if not token:
+        await websocket.close(code=1008, reason="Authentication required.")
+        return
+    try:
+        decode_token(token)
+    except HTTPException:
+        await websocket.close(code=1008, reason="Invalid or expired session.")
+        return
+    if "campusiq" not in offered:
+        await websocket.close(code=1008, reason="CampusIQ subprotocol required.")
+        return
+    await manager.connect(websocket, subprotocol="campusiq")
+    try:
+        db = SessionLocal()
+        try:
+            await websocket.send_json({"type": "snapshot", "payload": snapshot(db)})
+        finally:
+            db.close()
+        while True:
+            await websocket.receive_text()
+    except WebSocketDisconnect:
+        manager.disconnect(websocket)
+    except Exception:
+        manager.disconnect(websocket)
