+import { useEffect, useState } from 'react'
+import { Activity, AlertTriangle, ArrowDownToLine, Check, CheckCircle2, CircleAlert, Clock3, Database, Gauge, HeartPulse, Radio, RefreshCw, Server, ShieldCheck, Workflow } from 'lucide-react'
+import { api } from '../services/api'
+import { Button, formatTime, notify, PageHeading, StatusPill } from '../components/Primitives'
+
+const iconByName: Record<string, typeof Server> = { 'Backend API': Server, Database, 'AI inference engine': Workflow, 'Camera network': Radio, 'WebSocket stream': Activity, 'Demo simulator': HeartPulse }
+export function HealthPage() {
+  const [health, setHealth] = useState<Awaited<ReturnType<typeof api.health>> | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [lastChecked, setLastChecked] = useState<Date | null>(null)
+  const check = async (quiet = false) => { if (!quiet) setLoading(true); try { const data = await api.health(); setHealth(data); setLastChecked(new Date()) } catch (e) { if (!quiet) notify('Health check failed', e instanceof Error ? e.message : undefined, 'error') } finally { setLoading(false) } }
+  useEffect(() => { void check(); const timer = window.setInterval(() => void check(true), 15000); return () => window.clearInterval(timer) }, [])
+  const overall = health?.overall ?? 'DEGRADED'
+  return <div className="page-content">
+    <PageHeading eyebrow="PLATFORM OPERATIONS / SERVICE MONITOR" title="System health" description="A transparent view of the services and feeds powering campus operations."><Button variant="secondary" onClick={() => void check()} disabled={loading}><RefreshCw size={15} className={loading ? 'spin' : ''} />Run health check</Button></PageHeading>
+    <section className={`panel health-hero health-hero-${overall.toLowerCase()}`}><div className="health-hero-left"><div className="health-hero-icon">{overall === 'HEALTHY' ? <CheckCircle2 size={23} /> : <AlertTriangle size={23} />}</div><div><span className="panel-kicker">CAMPUSIQ SYSTEM STATUS</span><h2>{overall === 'HEALTHY' ? 'All systems operational' : 'System running with degraded services'}</h2><p>{health?.services.filter(service => service.status === 'HEALTHY').length ?? 0} of {health?.services.length ?? 0} platform services healthy · Demo telemetry is clearly labelled.</p></div></div><div className="health-hero-meta"><span className="health-overall-pill"><i />{overall}</span><small><Clock3 size={13} />Checked {lastChecked ? lastChecked.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '—'}</small></div></section>
+    <div className="health-services-grid">{health?.services.map(service => { const Icon = iconByName[service.name] ?? Activity; return <article key={service.name} className="panel health-service-card"><div className="health-service-top"><span className={`health-service-icon service-${service.status.toLowerCase()}`}><Icon size={17} /></span><StatusPill status={service.status} dot label={service.status} /></div><h3>{service.name}</h3><p>{service.detail}</p><div className="health-service-foot"><span>{service.latencyMs !== null ? <><Gauge size={13} />{service.latencyMs} ms latency</> : <><Activity size={13} />Operating normally</>}</span><span>LIVE</span></div></article> })}</div>
+    <div className="health-details-grid"><section className="panel health-detail-panel"><div className="health-detail-heading"><span className="health-detail-icon"><Radio size={17} /></span><div><span className="panel-kicker">INGESTION STATUS</span><h3>Camera connectivity</h3></div><button className="health-link" onClick={() => window.dispatchEvent(new CustomEvent('campusiq:navigate-cameras'))}>Manage cameras <ArrowDownToLine size={13} /></button></div><div className="health-camera-table">{health ? health.services.find(item => item.name === 'Camera network') && <HealthInfoRow label="Camera transport" value={health.services.find(item => item.name === 'Camera network')!.detail} status={health.services.find(item => item.name === 'Camera network')!.status} /> : null}<HealthInfoRow label="AI detection" value="Anonymous counting enabled · identity tracking disabled" status="HEALTHY" /><HealthInfoRow label="Last campus update" value={health?.lastDataUpdate ? new Date(health.lastDataUpdate).toLocaleString() : 'Awaiting telemetry'} status={health ? 'HEALTHY' : 'DEGRADED'} /><HealthInfoRow label="Realtime transport" value={`${health?.services.find(item => item.name === 'WebSocket stream')?.detail ?? 'Connecting…'}`} status={health?.services.find(item => item.name === 'WebSocket stream')?.status ?? 'DEGRADED'} /></div></section>
+    <section className="panel health-detail-panel"><div className="health-detail-heading"><span className="health-detail-icon health-detail-green"><ShieldCheck size={17} /></span><div><span className="panel-kicker">PRIVACY POSTURE</span><h3>Privacy & data controls</h3></div></div><div className="health-privacy-list"><div><span><Check size={14} />Face recognition</span><strong>Not used</strong></div><div><span><Check size={14} />Identity tracking</span><strong>Not used</strong></div><div><span><Check size={14} />Demo data labelling</span><strong>Enabled</strong></div><div><span><Check size={14} />Retention preference</span><strong>{String(health?.privacy.retentionDays ?? 30)} days · configured</strong></div></div><button className="health-settings-link" onClick={() => window.dispatchEvent(new CustomEvent('campusiq:navigate-settings'))}>Review privacy settings <ArrowDownToLine size={13} /></button></section></div>
+    <div className="health-footer-note"><HeartPulse size={15} /><span>Service health refreshes every 15 seconds. For production deployments, connect institutional alerting and observability systems.</span><span className="health-uptime">Uptime · {formatUptime(health?.uptimeSeconds ?? 0)}</span></div>
+  </div>
+}
+function HealthInfoRow({ label, value, status }: { label: string; value: string; status: string }) { return <div className="health-info-row"><span>{label}</span><strong>{value}</strong><StatusPill status={status} dot label={status === 'HEALTHY' ? 'Healthy' : status} /></div> }
+function formatUptime(seconds: number) { const days = Math.floor(seconds / 86400); const hours = Math.floor((seconds % 86400) / 3600); const minutes = Math.floor((seconds % 3600) / 60); return `${days ? `${days}d ` : ''}${hours}h ${minutes}m` }
