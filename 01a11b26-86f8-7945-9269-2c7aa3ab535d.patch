+import type { NavKey } from '../types'
+import { OverviewPage } from '../pages/OverviewPage'
+import { CamerasPage } from '../pages/CamerasPage'
+import { TwinPage } from '../pages/TwinPage'
+import { ClassroomsPage } from '../pages/ClassroomsPage'
+import { EventsPage } from '../pages/EventsPage'
+import { ParkingPage } from '../pages/ParkingPage'
+import { FacilitiesPage } from '../pages/FacilitiesPage'
+import { AnalyticsPage } from '../pages/AnalyticsPage'
+import { AlertsPage } from '../pages/AlertsPage'
+import { AssistantPage } from '../pages/AssistantPage'
+import { ResourcesPage } from '../pages/ResourcesPage'
+import { HealthPage } from '../pages/HealthPage'
+import { SettingsPage } from '../pages/SettingsPage'
+
+export const pageMeta: Record<NavKey, { title: string }> = {
+  overview: { title: 'Campus overview' }, cameras: { title: 'Camera monitoring' }, twin: { title: 'Digital twin' },
+  classrooms: { title: 'Classrooms' }, events: { title: 'Events & venues' }, parking: { title: 'Smart parking' },
+  facilities: { title: 'Facilities' }, analytics: { title: 'Analytics & reports' }, alerts: { title: 'Alert center' },
+  assistant: { title: 'Campus assistant' }, resources: { title: 'Resource directory' }, health: { title: 'System health' },
+  settings: { title: 'Privacy & settings' },
+}
+
+export function PageRenderer({ page, onPage }: { page: NavKey; onPage: (key: NavKey) => void }) {
+  switch (page) {
+    case 'overview': return <OverviewPage onPage={onPage} />
+    case 'cameras': return <CamerasPage />
+    case 'twin': return <TwinPage />
+    case 'classrooms': return <ClassroomsPage onPage={key => onPage(key)} />
+    case 'events': return <EventsPage />
+    case 'parking': return <ParkingPage />
+    case 'facilities': return <FacilitiesPage />
+    case 'analytics': return <AnalyticsPage />
+    case 'alerts': return <AlertsPage />
+    case 'assistant': return <AssistantPage />
+    case 'resources': return <ResourcesPage />
+    case 'health': return <HealthPage />
+    case 'settings': return <SettingsPage />
+  }
+}
