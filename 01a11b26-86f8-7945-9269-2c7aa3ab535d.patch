+async def sample_rtsp_sources(db: Session):
+    now = utcnow()
+    cameras = db.query(Camera).filter(Camera.source_type == "RTSP", Camera.stream_active.is_(True), Camera.source_uri.is_not(None)).all()
+    for camera in cameras[:12]:  # Bound concurrent camera sampling; deploy a worker pool for larger campuses.
+        retry_after = 45 if camera.status == "OFFLINE" else 12
+        if camera.last_updated and (now - camera.last_updated).total_seconds() < retry_after:
+            continue
+        try:
+            result = await run_in_threadpool(vision_engine.analyze_stream, reveal_camera_source(camera.source_uri) or "")
+            camera.status, camera.fps = "ONLINE", 15
+            camera.people_count, camera.vehicle_count = int(result["people"]), int(result["vehicles"])
+            camera.last_updated = utcnow()
+            offline_alert = db.query(Alert).filter(Alert.alert_type == "CAMERA_OFFLINE", Alert.location == camera.name, Alert.status == "ACTIVE").first()
+            if offline_alert:
+                offline_alert.status = "RESOLVED"
+            db.add(CameraEvent(id=new_id("ce"), camera_id=camera.id, event_type="ANONYMOUS_COUNT",
+                               people_count=camera.people_count, vehicle_count=camera.vehicle_count,
+                               confidence=float(result.get("confidence", 0)), recorded_at=utcnow(), metadata_json={"source": "RTSP", "sampledFrames": 1}))
+        except (VisionError, ValueError) as exc:
+            camera.status, camera.fps, camera.last_updated = "OFFLINE", 0, utcnow()
+            add_alert(db, "CAMERA_OFFLINE", f"{camera.name} camera is offline", camera.name, "LOW",
+                      f"RTSP feed could not provide a readable frame: {exc}", camera.building_id)
+    db.commit()
+
+
+async def simulation_loop():
+    while True:
+        await asyncio.sleep(5)
+        db = SessionLocal()
+        try:
+            await sample_rtsp_sources(db)
+            tick_demo(db)
+            payload = snapshot(db)
+            await manager.broadcast({"type": "snapshot", "payload": payload})
+        except Exception as exc:
+            print(f"CampusIQ demo loop warning: {exc}")
+            db.rollback()
+            await manager.broadcast({"type": "error", "message": "Live refresh paused briefly. Retrying automatically."})
+        finally:
+            db.close()
