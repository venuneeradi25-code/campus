+    """Issue a compact HS256 JWT without persisting a server-side session."""
+    now = int(time.time())
+    header = {"alg": "HS256", "typ": "JWT"}
+    payload = {"sub": user_id, "email": email, "name": name, "role": role, "iat": now, "exp": now + 60 * 60 * 10}
+    encode = lambda value: base64.urlsafe_b64encode(json.dumps(value, separators=(",", ":")).encode()).rstrip(b"=").decode()
+    head, body = encode(header), encode(payload)
+    signing_input = f"{head}.{body}"
+    sig = base64.urlsafe_b64encode(hmac.new(SECRET_KEY, signing_input.encode(), hashlib.sha256).digest()).rstrip(b"=").decode()
+    return f"{signing_input}.{sig}"
+
+
+def decode_token(token: str) -> dict:
+    try:
+        head, body, signature = token.split(".", 2)
+        signing_input = f"{head}.{body}"
+        expected = base64.urlsafe_b64encode(hmac.new(SECRET_KEY, signing_input.encode(), hashlib.sha256).digest()).rstrip(b"=").decode()
+        if not hmac.compare_digest(signature, expected):
+            raise ValueError("signature")
+        padded_head = head + "=" * (-len(head) % 4)
+        header = json.loads(base64.urlsafe_b64decode(padded_head))
+        if header.get("alg") != "HS256" or header.get("typ") != "JWT":
+            raise ValueError("algorithm")
+        padded = body + "=" * (-len(body) % 4)
+        payload = json.loads(base64.urlsafe_b64decode(padded))
+        if payload.get("exp", 0) < int(time.time()):
+            raise ValueError("expired")
+        return payload
+    except Exception as exc:
+        raise HTTPException(status_code=401, detail="Your session has expired. Please sign in again.") from exc
+
+
+bearer = HTTPBearer(auto_error=False)
+
+
+def current_user(credentials: HTTPAuthorizationCredentials | None = Depends(bearer)) -> dict:
+    if credentials is None:
+        raise HTTPException(status_code=401, detail="Sign in to access campus operations.")
+    return decode_token(credentials.credentials)
+
+
+def require_roles(*allowed: str):
+    def dependency(user: dict = Depends(current_user)) -> dict:
+        if user.get("role") not in allowed and user.get("role") != "SUPER ADMIN":
+            raise HTTPException(status_code=403, detail="Your role does not have permission for this action.")
+        return user
+    return dependency
