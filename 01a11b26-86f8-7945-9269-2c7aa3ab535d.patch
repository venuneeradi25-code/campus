+import { useMemo, useState } from 'react'
+import { Activity, ArrowRight, CalendarClock, CalendarPlus, Clock3, Ellipsis, MapPin, Pencil, Plus, Sparkles, TicketCheck, Trash2, Users2, Zap } from 'lucide-react'
+import type { CampusEvent, NavKey } from '../types'
+import { useCampus } from '../context/CampusContext'
+import { useAuth } from '../context/AuthContext'
+import { api } from '../services/api'
+import { Button, formatNumber, notify, PageHeading, StatusPill } from '../components/Primitives'
+import { Modal } from '../components/Modal'
+
+const filters = ['ALL', 'LIVE', 'UPCOMING', 'COMPLETED']
+export function EventsPage() {
+  const { snapshot, refresh } = useCampus()
+  const { user } = useAuth()
+  const [filter, setFilter] = useState('ALL')
+  const [formOpen, setFormOpen] = useState(false)
+  const [editing, setEditing] = useState<CampusEvent | undefined>()
+  const [busy, setBusy] = useState(false)
+  const canEdit = user?.role !== 'SECURITY ADMIN'
+  const events = useMemo(() => snapshot!.events.filter(event => filter === 'ALL' || (filter === 'LIVE' ? ['LIVE', 'WARNING', 'HIGH', 'CAPACITY REACHED'].includes(event.status) : event.status === filter)), [snapshot, filter])
+  const live = snapshot!.events.filter(event => ['LIVE', 'WARNING', 'HIGH', 'CAPACITY REACHED'].includes(event.status))
+  const warningCount = live.filter(event => event.occupancyPercent >= 80).length
+  const simulate = async (event: CampusEvent) => {
+    setBusy(true)
+    try { await api.simulateSpike(event.id); await refresh(); notify('Capacity warning generated', `${event.name} is now at a simulated 92% crowd level. Alert center updated.`, 'warning') }
+    catch (e) { notify('Could not simulate crowd spike', e instanceof Error ? e.message : undefined, 'error') }
+    finally { setBusy(false) }
+  }
+  const remove = async (event: CampusEvent) => {
+    if (!window.confirm(`Delete “${event.name}” from campus events?`)) return
+    try { await api.deleteEvent(event.id); await refresh(); notify('Event removed', event.name) }
+    catch (e) { notify('Could not remove event', e instanceof Error ? e.message : undefined, 'error') }
+  }
+  return <div className="page-content">
+    <PageHeading eyebrow="LIVE OPERATIONS / CAMPUS GATHERINGS" title="Events & venues" description="Track event plans, detected crowd size and venue thresholds in real time."><span className="demo-data-tag"><i /> LIVE DEMO</span><Button onClick={() => { setEditing(undefined); setFormOpen(true) }} disabled={!canEdit}><Plus size={16} />Create event</Button></PageHeading>
+    <div className="event-overview-stats"><div className="event-overview-stat"><span className="event-overview-icon live"><Activity size={18} /></span><span><small>Active events</small><strong>{live.length.toString().padStart(2, '0')}</strong><em>Live on campus</em></span></div><div className="event-overview-stat"><span className="event-overview-icon crowd"><Users2 size={18} /></span><span><small>People at events</small><strong>{formatNumber(live.reduce((sum, event) => sum + event.currentCrowd, 0))}</strong><em>Across all active venues</em></span></div><div className="event-overview-stat"><span className="event-overview-icon capacity"><TicketCheck size={18} /></span><span><small>Capacity warnings</small><strong className={warningCount ? 'event-warning-number' : ''}>{warningCount.toString().padStart(2, '0')}</strong><em>{warningCount ? 'Requires attention' : 'All below thresholds'}</em></span></div><button className="event-simulation-card" disabled={!canEdit || busy} onClick={() => live[0] && simulate(live[0])}><span><span className="sim-event-icon"><Zap size={17} /></span><span><strong>Test a crowd alert</strong><small>Simulate a 92% venue load to preview alerting.</small></span></span><span className="sim-event-arrow"><Sparkles size={16} />Simulate</span></button></div>
+    {live.length > 0 && <div className="events-featured-grid">{live.slice(0, 2).map(event => <FeaturedEvent key={event.id} event={event} onSpike={() => simulate(event)} busy={busy} onEdit={() => { setEditing(event); setFormOpen(true) }} canEdit={canEdit} />)}</div>}
+    <section className="panel events-list-panel"><div className="events-list-heading"><div><div className="panel-kicker">CAMPUS EVENT REGISTER</div><h2>Event schedule</h2><p>Manage expected attendance alongside anonymous live estimates.</p></div><button className="calendar-action" onClick={() => { setEditing(undefined); setFormOpen(true) }} disabled={!canEdit}><CalendarPlus size={15} />Add to schedule</button></div><div className="room-filter-tabs event-tabs">{filters.map(value => <button key={value} className={filter === value ? 'selected' : ''} onClick={() => setFilter(value)}>{value === 'ALL' ? `All events (${snapshot!.events.length})` : value[0] + value.slice(1).toLowerCase()}</button>)}</div><div className="table-scroll"><table className="data-table event-data-table"><thead><tr><th>EVENT</th><th>VENUE</th><th>DATE & TIME</th><th>EXPECTED</th><th>DETECTED CROWD</th><th>OCCUPANCY</th><th>STATUS</th><th /></tr></thead><tbody>{events.map(event => <tr key={event.id}><td><span className="event-name-cell"><span className="event-row-icon"><CalendarClock size={15} /></span><span><strong>{event.name}</strong><small>{event.category}</small></span></span></td><td><span className="event-venue-cell"><MapPin size={13} />{event.venue}</span></td><td><span className="event-schedule-cell"><strong>{new Date(event.startTime).toLocaleDateString([], { month: 'short', day: 'numeric' })}</strong><small>{new Date(event.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} – {new Date(event.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small></span></td><td>{formatNumber(event.expectedCrowd)}</td><td><strong>{formatNumber(event.currentCrowd)}</strong><span className="event-of-capacity"> / {formatNumber(event.capacity)}</span></td><td><div className="table-occupancy"><span>{event.occupancyPercent.toFixed(1)}%</span><div><i className={event.occupancyPercent >= 90 ? 'high' : event.occupancyPercent >= 80 ? 'warning' : ''} style={{ width: `${Math.min(100, event.occupancyPercent)}%` }} /></div></div></td><td><StatusPill status={event.status} dot label={event.status === 'LIVE' ? 'LIVE' : event.status} /></td><td><div className="event-row-actions"><button title="Edit event" onClick={() => { setEditing(event); setFormOpen(true) }} disabled={!canEdit}><Pencil size={14} /></button><button title="Remove event" onClick={() => remove(event)} disabled={!canEdit}><Trash2 size={14} /></button></div></td></tr>)}</tbody></table>{!events.length && <div className="table-empty"><CalendarClock size={20} /><strong>No events in this view</strong><span>Try another filter or create an event.</span></div>}</div></section>
+    <div className="event-threshold-banner"><span className="threshold-icon">80</span><div><strong>Configurable crowd thresholds</strong><span>Warning at 80% · High at 90% · Capacity reached at 100%. Demo Mode can trigger an alert instantly.</span></div><button onClick={() => window.dispatchEvent(new CustomEvent('campusiq:navigate-alerts'))}>View alert center <ArrowRight size={14} /></button></div>
+    {formOpen && <EventFormModal event={editing} onClose={() => setFormOpen(false)} onSaved={async () => { setFormOpen(false); await refresh() }} />}
+  </div>
+}
+
+function FeaturedEvent({ event, onSpike, busy, onEdit, canEdit }: { event: CampusEvent; onSpike: () => void; busy: boolean; onEdit: () => void; canEdit: boolean }) {
+  const percent = Math.min(100, event.occupancyPercent)
+  const tone = percent >= 90 ? 'danger' : percent >= 80 ? 'warning' : 'normal'
+  return <article className={`panel featured-event featured-event-${tone}`}><div className="featured-event-header"><div className="featured-event-icon"><CalendarClock size={18} /></div><StatusPill status={event.status} dot label={event.status === 'LIVE' ? 'LIVE NOW' : event.status} /><button className="event-card-edit" onClick={onEdit} disabled={!canEdit} aria-label="Edit event"><Pencil size={14} /></button></div><div className="featured-event-content"><div className="panel-kicker">{event.category.toUpperCase()} EVENT</div><h3>{event.name}</h3><div className="featured-event-meta"><span><MapPin size={13} />{event.venue}</span><span><Clock3 size={13} />Ends {new Date(event.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span></div><div className="featured-crowd-count"><div><strong>{formatNumber(event.currentCrowd)}</strong><span> detected</span></div><span>of {formatNumber(event.capacity)} capacity</span><b>{event.occupancyPercent.toFixed(1)}%</b></div><div className={`featured-progress progress-${tone}`}><i style={{ width: `${percent}%` }} /></div><div className="featured-event-footer"><span>{percent >= 90 ? 'Near venue capacity' : percent >= 80 ? 'Warning threshold crossed' : 'Within configured limits'}</span><button disabled={busy || !canEdit} onClick={onSpike}><Zap size={13} />Trigger warning</button></div></div></article>
+}
+
+function EventFormModal({ event, onClose, onSaved }: { event?: CampusEvent; onClose: () => void; onSaved: () => Promise<void> }) {
+  const { snapshot } = useCampus()
+  const [name, setName] = useState(event?.name ?? '')
+  const [venue, setVenue] = useState(event?.venue ?? '')
+  const [buildingId, setBuildingId] = useState(event?.buildingId ?? 'auditorium')
+  const [start, setStart] = useState(event ? toLocalInput(event.startTime) : toLocalInput(new Date(Date.now() + 60 * 60 * 1000).toISOString()))
+  const [end, setEnd] = useState(event ? toLocalInput(event.endTime) : toLocalInput(new Date(Date.now() + 3 * 60 * 60 * 1000).toISOString()))
+  const [capacity, setCapacity] = useState(event?.capacity ?? 300)
+  const [expected, setExpected] = useState(event?.expectedCrowd ?? 0)
+  const [category, setCategory] = useState(event?.category ?? 'Campus')
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState(false)
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault(); setBusy(true); setError('')
+    const body = { name, venue, building_id: buildingId, start_time: new Date(start).toISOString(), end_time: new Date(end).toISOString(), capacity: Number(capacity), expected_crowd: Number(expected), category }
+    try { if (event) await api.updateEvent(event.id, body); else await api.createEvent(body); notify(event ? 'Event updated' : 'Event created', name); await onSaved() }
+    catch (e) { setError(e instanceof Error ? e.message : 'Could not save the event.') }
+    finally { setBusy(false) }
+  }
+  return <Modal title={event ? 'Edit campus event' : 'Create a campus event'} description="Plan a venue and compare expected attendance with anonymous live counts." onClose={onClose}>
+    <form className="modal-form" onSubmit={submit}><label>Event name<input required minLength={3} value={name} onChange={e => setName(e.target.value)} placeholder="e.g. Innovation Week keynote" /></label><div className="form-grid"><label>Venue<input required value={venue} onChange={e => setVenue(e.target.value)} placeholder="Venue name" /></label><label>Building<select value={buildingId} onChange={e => setBuildingId(e.target.value)}>{snapshot!.buildings.map(building => <option key={building.id} value={building.id}>{building.name}</option>)}</select></label></div><div className="form-grid"><label>Start time<input required type="datetime-local" value={start} onChange={e => setStart(e.target.value)} /></label><label>End time<input required type="datetime-local" value={end} onChange={e => setEnd(e.target.value)} /></label></div><div className="form-grid"><label>Maximum capacity<input required type="number" min="1" value={capacity} onChange={e => setCapacity(Number(e.target.value))} /></label><label>Expected crowd<input type="number" min="0" value={expected} onChange={e => setExpected(Number(e.target.value))} /></label></div><label>Event type<select value={category} onChange={e => setCategory(e.target.value)}><option>Campus</option><option>Technology</option><option>Research</option><option>Community</option><option>Academic</option><option>Sports</option></select></label>{error && <div className="form-error">{error}</div>}<div className="modal-actions"><Button variant="secondary" onClick={onClose}>Cancel</Button><Button type="submit" disabled={busy}>{busy ? 'Saving…' : event ? 'Save changes' : 'Create event'}</Button></div></form>
+  </Modal>
+}
+function toLocalInput(value: string) { const date = new Date(value); const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000); return local.toISOString().slice(0, 16) }
