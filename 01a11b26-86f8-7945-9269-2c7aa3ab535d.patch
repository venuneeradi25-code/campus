+app = FastAPI(title="CampusIQ API", description="Privacy-first campus operations API with live demo data.", version="1.0.0", lifespan=lifespan)
+app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=False, allow_methods=["*"], allow_headers=["*"])
