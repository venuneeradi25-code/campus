+import { useRef, useState } from 'react'
+import { Activity, Camera as CameraIcon, CarFront, CircleAlert, Eye, FileVideo2, Link2, LoaderCircle, Plus, Power, Radio, RefreshCw, ShieldCheck, Sparkles, Wifi } from 'lucide-react'
+import type { Camera } from '../types'
+import { useCampus } from '../context/CampusContext'
+import { useAuth } from '../context/AuthContext'
+import { api } from '../services/api'
+import { Button, notify, PageHeading, StatusPill } from '../components/Primitives'
+import { CameraScene } from '../components/CameraScene'
+import { Modal } from '../components/Modal'
+
+export function CamerasPage() {
+  const { snapshot, refresh } = useCampus()
+  const { user } = useAuth()
+  const [filter, setFilter] = useState<'ALL' | 'ONLINE' | 'OFFLINE'>('ALL')
+  const [showCreate, setShowCreate] = useState(false)
+  const [busy, setBusy] = useState<string | null>(null)
+  const canManage = user?.role === 'SUPER ADMIN' || user?.role === 'SECURITY ADMIN'
+  const cameras = snapshot!.cameras.filter(cam => filter === 'ALL' || cam.status === filter)
+  const online = snapshot!.cameras.filter(cam => cam.status === 'ONLINE').length
+
+  const doAction = async (camera: Camera, action: 'stream' | 'ai' | 'test' | 'delete') => {
+    setBusy(`${camera.id}-${action}`)
+    try {
+      if (action === 'stream') await api.toggleCamera(camera.id, { stream_active: !camera.streamActive })
+      if (action === 'ai') await api.toggleCamera(camera.id, { ai_enabled: !camera.aiEnabled })
+      if (action === 'test') { const result = await api.testCamera(camera.id); notify(result.ok ? 'Connection healthy' : 'Connection test', result.message, result.ok ? 'success' : 'warning') }
+      if (action === 'delete') {
+        if (!window.confirm(`Remove ${camera.name} from camera management?`)) return
+        await api.deleteCamera(camera.id); notify('Camera removed', `${camera.name} is no longer in the monitoring roster.`)
+      }
+      await refresh()
+    } catch (e) { notify('Camera action failed', e instanceof Error ? e.message : undefined, 'error') }
+    finally { setBusy(null) }
+  }
+  const onUpload = async (camera: Camera, file?: File) => {
+    if (!file) return
+    setBusy(`${camera.id}-upload`)
+    try {
+      const response = await api.uploadVideo(camera.id, file)
+      const analysis = response.analysis
+      const count = analysis.average_people
+      notify('Video processed', typeof count === 'number' ? `Anonymous average count: ${count} people across ${analysis.sampled_frames ?? 0} sampled frames. The source clip was discarded.` : String(analysis.message ?? 'The source clip was discarded after processing.'))
+      await refresh()
+    } catch (e) { notify('Video upload failed', e instanceof Error ? e.message : undefined, 'error') }
+    finally { setBusy(null) }
+  }
+  return <div className="page-content">
+    <PageHeading eyebrow="LIVE OPERATIONS / COMPUTER VISION" title="Camera monitoring" description="Anonymous people and vehicle counts from campus camera feeds."><div className="camera-page-status"><span className="camera-page-status-dot" /><strong>{online} online</strong><span>of {snapshot!.cameras.length}</span></div><Button onClick={() => setShowCreate(true)} disabled={!canManage}><Plus size={16} />Add camera</Button></PageHeading>
+    <div className="camera-page-toolbar"><div className="camera-page-toolbar-copy"><span className="demo-data-tag"><i /> DEMO FEEDS</span><span>Feeds are simulated for this workspace. RTSP is sampled server-side; uploaded clips are analyzed temporarily and discarded.</span></div><div className="segmented-control">{(['ALL', 'ONLINE', 'OFFLINE'] as const).map(value => <button key={value} className={filter === value ? 'selected' : ''} onClick={() => setFilter(value)}>{value === 'ALL' ? `All (${snapshot!.cameras.length})` : value === 'ONLINE' ? `Online (${online})` : `Offline (${snapshot!.cameras.length - online})`}</button>)}</div></div>
+    {cameras.length ? <div className="camera-grid">{cameras.map(camera => <CameraCard key={camera.id} camera={camera} busy={busy} canManage={canManage} onAction={doAction} onUpload={onUpload} />)}</div> : <div className="panel camera-empty"><CameraIcon size={24} /><strong>No cameras match this view</strong><span>Choose another status filter or add a camera.</span></div>}
+    <div className="camera-privacy-note"><ShieldCheck size={18} /><div><strong>Built for anonymous monitoring.</strong><span>IQ Vision estimates people and vehicle counts. Facial identification, identity tracking and biometric data are not used.</span></div><button onClick={() => window.dispatchEvent(new CustomEvent('campusiq:navigate-settings'))}>Privacy details <Link2 size={14} /></button></div>
+    {showCreate && <AddCameraModal onClose={() => setShowCreate(false)} onCreated={async () => { setShowCreate(false); await refresh() }} />}
+  </div>
+}
+
+function CameraCard({ camera, busy, canManage, onAction, onUpload }: { camera: Camera; busy: string | null; canManage: boolean; onAction: (camera: Camera, action: 'stream' | 'ai' | 'test' | 'delete') => void; onUpload: (camera: Camera, file?: File) => void }) {
+  const inputRef = useRef<HTMLInputElement>(null)
+  const isBusy = busy?.startsWith(camera.id) ?? false
+  const active = camera.status === 'ONLINE' && camera.streamActive
+  return <article className="panel camera-card">
+    <div className="camera-card-heading"><div className="camera-card-camera-icon"><CameraIcon size={17} /></div><div className="camera-card-title"><strong>{camera.name}</strong><span>{camera.location}</span></div><StatusPill status={camera.status} dot label={camera.status === 'ONLINE' ? 'ONLINE' : camera.status} /></div>
+    <div className="camera-feed-wrap"><CameraScene camera={camera} /><div className="camera-feed-topline"><span className="feed-camera-id">{camera.id}</span><span className={`feed-live-tag ${active ? '' : 'feed-live-off'}`}>{active && <i />}{active ? 'LIVE' : 'OFFLINE'}</span></div><div className="camera-feed-bottomline"><span><Wifi size={12} />{active ? `${camera.fps} FPS` : 'SIGNAL LOST'}</span><span className={`ai-chip ${camera.aiEnabled ? '' : 'ai-chip-off'}`}><Activity size={11} />AI {camera.aiEnabled && active ? 'ACTIVE' : 'PAUSED'}</span></div>{isBusy && <div className="camera-action-overlay"><LoaderCircle size={21} className="spin" /><span>Processing feed…</span></div>}</div>
+    <div className="camera-detection-row"><div className="camera-detection"><span className="detection-label"><Eye size={13} />PEOPLE</span><strong>{camera.status === 'ONLINE' ? camera.peopleCount : '—'}</strong></div><div className="camera-detection"><span className="detection-label"><CarFrontIcon />VEHICLES</span><strong>{camera.status === 'ONLINE' ? camera.vehicleCount : '—'}</strong></div><div className="camera-detection camera-detection-updated"><span className="detection-label">LAST SIGNAL</span><strong>{camera.status === 'ONLINE' ? 'just now' : '7m ago'}</strong></div></div>
+    <div className="camera-card-footer"><div className="camera-source"><span className="source-indicator" />{camera.sourceType === 'DEMO' ? 'SIMULATED SOURCE' : camera.sourceType === 'VIDEO' ? 'UPLOADED VIDEO' : 'SECURE RTSP'}{camera.hasSource && <span className="source-lock"><ShieldCheck size={11} />credentials protected</span>}</div><div className="camera-card-actions">
+      <input ref={inputRef} type="file" accept="video/*,.mp4,.mov,.avi" className="visually-hidden" onChange={e => onUpload(camera, e.target.files?.[0])} />
+      <button className="camera-mini-action" disabled={!canManage || isBusy} title="Upload sample video" onClick={() => inputRef.current?.click()}><FileVideo2 size={15} /></button>
+      <button className={`camera-mini-action ${camera.aiEnabled ? 'camera-action-active' : ''}`} disabled={!canManage || isBusy} title={camera.aiEnabled ? 'Disable AI detection' : 'Enable AI detection'} onClick={() => onAction(camera, 'ai')}><Activity size={15} /></button>
+      <button className="camera-mini-action" disabled={!canManage || isBusy} title="Test camera connection" onClick={() => onAction(camera, 'test')}><RefreshCw size={14} /></button>
+      <button className={`camera-power-button ${active ? 'powered' : ''}`} disabled={!canManage || isBusy} title={active ? 'Stop demo feed' : 'Start demo feed'} onClick={() => onAction(camera, 'stream')}>{active ? <Power size={14} /> : <PlayIcon />}{active ? 'Stop' : 'Start'}</button>
+    </div></div>
+  </article>
+}
+
+function AddCameraModal({ onClose, onCreated }: { onClose: () => void; onCreated: () => Promise<void> }) {
+  const { snapshot } = useCampus()
+  const [name, setName] = useState('')
+  const [location, setLocation] = useState('')
+  const [building, setBuilding] = useState(snapshot!.buildings[0]?.id ?? 'main')
+  const [sourceType, setSourceType] = useState<'DEMO' | 'RTSP'>('DEMO')
+  const [sourceUri, setSourceUri] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault(); setBusy(true); setError('')
+    try {
+      await api.createCamera({ name, location, building_id: building, source_type: sourceType, ...(sourceType === 'RTSP' ? { source_uri: sourceUri } : {}) })
+      notify('Camera added', `${name} is now in your camera roster.`)
+      await onCreated()
+    } catch (e) { setError(e instanceof Error ? e.message : 'Could not add this camera.') }
+    finally { setBusy(false) }
+  }
+  return <Modal title="Add a campus camera" description="Connect a demo stream or configure an RTSP source securely on the backend." onClose={onClose}>
+    <form className="modal-form" onSubmit={submit}>
+      <div className="form-grid"><label>Camera name<input required minLength={2} value={name} onChange={e => setName(e.target.value)} placeholder="e.g. West Entry" /></label><label>Location<input required minLength={2} value={location} onChange={e => setLocation(e.target.value)} placeholder="Building and area" /></label></div>
+      <label>Building<select value={building} onChange={e => setBuilding(e.target.value)}>{snapshot!.buildings.map(item => <option value={item.id} key={item.id}>{item.name}</option>)}</select></label>
+      <div className="source-type-toggle"><button type="button" className={sourceType === 'DEMO' ? 'selected' : ''} onClick={() => setSourceType('DEMO')}><Sparkles size={15} />Demo feed</button><button type="button" className={sourceType === 'RTSP' ? 'selected' : ''} onClick={() => setSourceType('RTSP')}><Radio size={15} />RTSP camera</button></div>
+      {sourceType === 'RTSP' && <><label>Secure RTSP source URL<input required type="password" autoComplete="new-password" value={sourceUri} onChange={e => setSourceUri(e.target.value)} placeholder="rtsp://username:••••@camera.local/stream" /></label><div className="secure-url-note"><ShieldCheck size={15} />Sent only to the backend, encrypted in the database, and never returned in camera listings or dashboard responses.</div></>}
+      {error && <div className="form-error"><CircleAlert size={15} />{error}</div>}
+      <div className="modal-actions"><Button variant="secondary" onClick={onClose}>Cancel</Button><Button type="submit" disabled={busy}>{busy ? <LoaderCircle size={15} className="spin" /> : <Plus size={15} />}{busy ? 'Adding camera…' : 'Add camera'}</Button></div>
+    </form>
+  </Modal>
+}
+function PlayIcon() { return <span className="play-triangle" /> }
+function CarFrontIcon() { return <span className="car-mini-glyph">▰</span> }
