+import { useMemo, useState } from 'react'
+import { BookOpen, Building2, Coffee, Dumbbell, FlaskConical, Laptop, LayoutGrid, Library, Search, Users2 } from 'lucide-react'
+import type { Facility } from '../types'
+import { useCampus } from '../context/CampusContext'
+import { formatNumber, PageHeading, StatusPill } from '../components/Primitives'
+
+const icons = [Library, Coffee, LayoutGrid, FlaskConical, Laptop, Dumbbell]
+const filters = ['All facilities', 'Library', 'Cafeteria', 'Laboratory', 'Seminar Hall', 'Computer Lab', 'Sports']
+export function FacilitiesPage() {
+  const { snapshot } = useCampus()
+  const [filter, setFilter] = useState('All facilities')
+  const [query, setQuery] = useState('')
+  const facilities = useMemo(() => snapshot!.facilities.filter(item => (filter === 'All facilities' || item.type === filter) && `${item.name} ${item.type}`.toLowerCase().includes(query.toLowerCase())), [snapshot, filter, query])
+  const openCount = snapshot!.facilities.filter(item => item.isOpen).length
+  const totalCapacity = snapshot!.facilities.reduce((sum, facility) => sum + facility.capacity, 0)
+  const occupancy = snapshot!.facilities.reduce((sum, facility) => sum + facility.occupancy, 0)
+  return <div className="page-content">
+    <PageHeading eyebrow="CAMPUS OPERATIONS / SHARED SPACES" title="Facilities" description="See how shared campus spaces are being used, from the library to research labs."><span className="facility-status-summary"><i />{openCount} facilities open</span></PageHeading>
+    <div className="facility-summary-row"><div className="facility-summary"><span className="facility-summary-icon"><LayoutGrid size={17} /></span><span><small>Monitored spaces</small><strong>{snapshot!.facilities.length.toString().padStart(2, '0')}</strong></span></div><div className="facility-summary"><span className="facility-summary-icon"><Users2 size={17} /></span><span><small>Current occupancy</small><strong>{formatNumber(occupancy)}<em> / {formatNumber(totalCapacity)}</em></strong></span></div><div className="facility-summary"><span className="facility-summary-icon facility-summary-open"><i /></span><span><small>Average utilization</small><strong>{Math.round(occupancy / Math.max(totalCapacity, 1) * 100)}<em>%</em></strong></span></div><div className="facility-summary"><span className="facility-summary-icon facility-summary-library"><BookOpen size={17} /></span><span><small>Peak period today</small><strong>12–2<em> PM</em></strong></span></div></div>
+    <div className="facility-filters"><div className="filter-pills">{filters.map(item => <button key={item} className={filter === item ? 'active' : ''} onClick={() => setFilter(item)}>{item}</button>)}</div><label className="facility-search"><Search size={15} /><input placeholder="Find a facility" value={query} onChange={e => setQuery(e.target.value)} /></label></div>
+    <div className="facility-grid">{facilities.map((facility, index) => <FacilityCard key={facility.id} facility={facility} icon={icons[index % icons.length]} />)}</div>
+    {facilities.length === 0 && <div className="panel facility-empty"><Search size={22} /><strong>No facilities match that search</strong><span>Try a different space or facility type.</span></div>}
+    <div className="facility-safety-note"><Building2 size={16} /><div><strong>Utilization is an estimate.</strong><span>Counts reflect anonymous sensor signals and are not intended for individual attendance or performance tracking.</span></div></div>
+  </div>
+}
+function FacilityCard({ facility, icon: Icon }: { facility: Facility; icon: typeof Library }) {
+  const percentage = Math.min(facility.occupancyPercent, 100)
+  const level = percentage >= 90 ? 'critical' : percentage >= 80 ? 'high' : 'normal'
+  return <article className={`panel facility-card facility-${level}`}><div className="facility-card-top"><div className={`facility-icon facility-icon-${facility.type.toLowerCase().replaceAll(' ', '-')}`}><Icon size={18} /></div><StatusPill status={facility.isOpen ? facility.status : 'OFFLINE'} dot label={facility.isOpen ? facility.status : 'CLOSED'} /></div><span className="facility-type-label">{facility.type.toUpperCase()}</span><h3>{facility.name}</h3><p className="facility-building"><Building2 size={13} />{buildingName(facility.buildingId)}</p><div className="facility-occupancy-row"><span>Occupancy</span><strong>{facility.occupancy}<small> / {facility.capacity}</small></strong><em>{facility.occupancyPercent}%</em></div><div className={`facility-progress progress-${level}`}><i style={{ width: `${percentage}%` }} /></div><div className="facility-card-footer"><span><Users2 size={13} />Capacity {facility.capacity}</span><span>Peak · {facility.peakUsage}</span></div></article>
+}
+function buildingName(id: string) { return ({ main: 'Main Block', cse: 'CSE Block', 'ai-ds': 'AI & DS Block', library: 'Knowledge Commons', auditorium: 'Grand Auditorium', labs: 'Innovation Labs', sports: 'Sports Complex' } as Record<string, string>)[id] ?? id }
