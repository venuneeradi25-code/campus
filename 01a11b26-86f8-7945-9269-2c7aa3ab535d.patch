+:root { font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #192b3a; background: #f3f6f9; font-synthesis: none; text-rendering: optimizeLegibility; font-optical-sizing: auto; }
+* { box-sizing: border-box; }
+html { min-width: 320px; background: #f3f6f9; }
+body { margin: 0; min-width: 320px; min-height: 100vh; font-size: 13px; -webkit-font-smoothing: antialiased; }
+button, input, select, textarea { font: inherit; }
+button { color: inherit; }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [role="button"]:focus-visible { outline: 3px solid rgba(35, 156, 116, .23); outline-offset: 2px; }
+button:disabled { opacity: .54; cursor: not-allowed !important; }
+::selection { background: #d8f2e7; color: #143b2d; }
+
+/* app chrome */
+.app-frame { min-height: 100vh; background: #f3f6f9; }
+.sidebar { position: fixed; inset: 0 auto 0 0; z-index: 30; width: 248px; display: flex; flex-direction: column; background: #14283b; color: #d6e0e8; box-shadow: 10px 0 32px rgba(24, 47, 65, .04); }
+.sidebar-brand-row { height: 67px; padding: 0 19px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid rgba(255,255,255,.075); }
+.sidebar-brand-symbol, .brand-symbol { display: grid; place-items: center; color: #eefcf5; background: #178a68; border-radius: 10px; box-shadow: inset 0 1px rgba(255,255,255,.17), 0 5px 15px rgba(15,123,87,.25); }
+.sidebar-brand-symbol { width: 32px; height: 32px; }
+.sidebar-brand { font-size: 18px; line-height: 1; color: #f3f8fa; font-weight: 720; letter-spacing: -.7px; }
+.sidebar-brand span { color: #79d5b0; font-weight: 600; }
+.campus-switcher { margin: 16px 14px 14px; padding: 10px 9px; width: calc(100% - 28px); display: flex; align-items: center; gap: 9px; color: #eaf0f4; border: 1px solid rgba(255,255,255,.095); border-radius: 10px; background: rgba(255,255,255,.045); text-align: left; cursor: pointer; transition: .18s ease; }
+.campus-switcher:hover { background: rgba(255,255,255,.075); }
+.campus-avatar { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 8px; background: #e3f5eb; color: #167957; font-size: 10px; font-weight: 800; letter-spacing: .2px; }
+.campus-switcher-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
+.campus-switcher-copy strong { font-size: 11.5px; font-weight: 640; color: #f1f5f7; }
+.campus-switcher-copy small { font-size: 8px; letter-spacing: 1.05px; color: #879aaa; font-weight: 680; }
+.campus-switcher > svg { color: #8fa1ae; }
+.nav-scroll { padding: 0 10px; flex: 1; overflow: auto; scrollbar-width: thin; scrollbar-color: #3b5165 transparent; }
+.nav-section { padding: 7px 0 9px; }
+.nav-section-label { margin: 9px 9px 8px; color: #8295a5; font-size: 9px; font-weight: 750; letter-spacing: 1.2px; }
+.nav-item { position: relative; width: 100%; height: 38px; display: flex; align-items: center; gap: 11px; margin: 2px 0; padding: 0 11px; background: transparent; border: 0; border-radius: 8px; color: #abbac5; text-align: left; cursor: pointer; font-size: 11.5px; font-weight: 510; transition: color .15s, background .15s, transform .15s; }
+.nav-item:hover { color: #eef6f2; background: rgba(255,255,255,.06); }
+.nav-item:active { transform: scale(.99); }
+.nav-item svg { flex: 0 0 auto; color: #8499a9; }
+.nav-item-active { color: #ecfaf4; background: #1e3d4b; font-weight: 630; box-shadow: inset 2.5px 0 #4ccea0; }
+.nav-item-active svg { color: #78d8b0; }
+.nav-item em { margin-left: auto; min-width: 19px; height: 18px; display: grid; place-items: center; padding: 0 5px; border-radius: 6px; background: #8e4849; color: #fff2ed; font-size: 9px; font-style: normal; font-weight: 730; }
+.nav-item-secondary { height: 35px; font-size: 11px; }
+.nav-divider { height: 1px; margin: 8px 8px 8px; background: rgba(255,255,255,.075); }
+.sidebar-bottom { padding: 9px 13px 14px; }
+.demo-mode-card { padding: 11px 12px 10px; border-radius: 10px; background: linear-gradient(135deg, rgba(20,142,99,.2), rgba(32,79,75,.15)); border: 1px solid rgba(86,204,156,.2); }
+.demo-mode-card.demo-paused { background: rgba(255,255,255,.035); border-color: rgba(255,255,255,.1); }
+.demo-mode-top { display: flex; align-items: center; gap: 7px; color: #84dbb4; font-size: 8.5px; letter-spacing: .75px; font-weight: 760; }
+.demo-paused .demo-mode-top { color: #b1bfca; }
+.demo-indicator { width: 7px; height: 7px; display: grid; place-items: center; border-radius: 50%; background: #5cdda7; box-shadow: 0 0 0 3px rgba(92,221,167,.11); }
+.demo-paused .demo-indicator { background: #adb9c4; box-shadow: none; }
+.demo-indicator i { width: 3px; height: 3px; background: #163d35; border-radius: 50%; }
+.demo-spark { margin-left: auto; font-size: 14px; color: #c2ffe3; }
+.demo-mode-card p { margin: 8px 0 9px; color: #b4c5cb; font-size: 9.5px; line-height: 1.5; }
+.demo-mode-card button { padding: 0; display: flex; align-items: center; gap: 5px; color: #8bdcb9; background: none; border: 0; cursor: pointer; font-size: 9.5px; font-weight: 600; }
+.demo-mode-card button:hover { color: #c8ffe5; }
+.arrow-glyph { font-size: 12px; }
+.help-link { width: 100%; display: flex; align-items: center; gap: 9px; padding: 13px 4px 2px; color: #99aab7; border: 0; background: none; cursor: pointer; font-size: 10.5px; text-align: left; }
+.help-link:hover { color: #e8f2f5; }
+.help-shortcut { margin-left: auto; color: #718593; font-size: 9px; }
+.app-main { min-height: 100vh; margin-left: 248px; display: flex; flex-direction: column; }
+.topbar { position: sticky; top: 0; z-index: 20; min-height: 66px; height: 66px; display: flex; align-items: center; justify-content: space-between; padding: 0 29px; background: rgba(255,255,255,.94); backdrop-filter: blur(16px); border-bottom: 1px solid #e7ecf0; }
+.topbar-left, .topbar-right { display: flex; align-items: center; }
+.breadcrumb { display: flex; align-items: center; gap: 10px; color: #99a6af; font-size: 11px; }
+.breadcrumb i { color: #c4cdd4; font-style: normal; }
+.breadcrumb strong { color: #3c4f5c; font-size: 11.5px; font-weight: 630; }
+.topbar-right { gap: 13px; }
+.topbar-campus { display: flex; align-items: center; gap: 7px; color: #657781; font-size: 10.5px; font-weight: 550; }
+.campus-online-dot, .connection-dots i, .footer-live-dot { width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: #32ad7a; box-shadow: 0 0 0 3px rgba(50,173,122,.11); }
+.topbar-campus svg { color: #9caab3; }
+.connection-badge { height: 24px; padding: 0 8px; display: flex; align-items: center; gap: 6px; color: #22845f; background: #eaf7f1; border: 1px solid #dcefe6; border-radius: 6px; font-size: 8px; font-weight: 790; letter-spacing: .65px; }
+.connection-reconnecting { color: #8a7541; background: #faf6e9; border-color: #eee5c7; }
+.connection-dots { display: flex; gap: 2px; align-items: center; }
+.connection-dots i { width: 3px; height: 7px; border-radius: 2px; box-shadow: none; animation: pulse-bars 1s ease-in-out infinite alternate; }
+.connection-dots i:nth-child(2) { animation-delay: .2s; height: 10px; }
+.connection-dots i:nth-child(3) { animation-delay: .4s; height: 5px; }
+.connection-reconnecting .connection-dots i { background: #b9a45c; }
+@keyframes pulse-bars { to { opacity: .48; transform: scaleY(.6); } }
+.topbar-time { display: flex; align-items: center; gap: 6px; color: #71808a; font-size: 10px; font-variant-numeric: tabular-nums; }
+.topbar-time svg { color: #93a1aa; }
+.topbar-divider { width: 1px; height: 23px; background: #e7ecf0; }
+.top-action-wrap { position: relative; }
+.topbar-icon { position: relative; width: 32px; height: 32px; display: grid; place-items: center; padding: 0; background: transparent; color: #73828c; border: 1px solid transparent; border-radius: 8px; cursor: pointer; transition: .15s ease; }
+.topbar-icon:hover, .topbar-icon-active { background: #f1f6f5; border-color: #e5eeea; color: #247958; }
+.notification-count { position: absolute; right: 0; top: 0; min-width: 15px; height: 15px; padding: 0 4px; display: grid; place-items: center; border-radius: 7px; background: #cb594d; color: white; border: 2px solid white; font-size: 7.5px; font-weight: 750; }
+.profile-button { display: flex; align-items: center; gap: 8px; padding: 0 2px 0 0; background: none; border: none; text-align: left; cursor: pointer; }
+.profile-avatar { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; background: #e2f3eb; color: #287a5c; font-size: 9px; font-weight: 790; letter-spacing: .3px; }
+.profile-copy { min-width: 80px; display: flex; flex-direction: column; gap: 3px; }
+.profile-copy strong { color: #40525e; font-size: 10.5px; font-weight: 650; }
+.profile-copy small { max-width: 105px; overflow: hidden; color: #95a2aa; font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
+.profile-button > svg { color: #9aa6af; }
+.top-popover { position: absolute; top: calc(100% + 12px); right: 0; z-index: 40; background: #fff; border: 1px solid #e7ecef; border-radius: 12px; box-shadow: 0 18px 45px rgba(26, 46, 61, .14); animation: pop-in .15s ease-out; }
+@keyframes pop-in { from { opacity: 0; transform: translateY(-4px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
+.search-popover { width: 340px; padding: 9px; right: -85px; }
+.search-popover-input { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 9px; border: 1px solid #dfe8e4; border-radius: 8px; color: #71827e; background: #fafcfb; }
+.search-popover-input input { min-width: 0; flex: 1; border: 0; outline: 0; color: #283e4b; background: transparent; font-size: 10.5px; }
+.search-popover-input input::placeholder { color: #a2afb5; }
+.search-popover-input kbd { padding: 3px 5px; color: #8b999f; background: white; border: 1px solid #e7ecef; border-radius: 4px; font-size: 8px; }
+.popover-caption { padding: 12px 8px 6px; color: #9ba8af; font-size: 8px; letter-spacing: 1px; font-weight: 720; }
+.search-result { width: 100%; padding: 8px; display: flex; align-items: center; gap: 9px; border: 0; border-radius: 7px; background: transparent; text-align: left; cursor: pointer; }
+.search-result:hover { background: #f2f8f5; }
+.search-result-icon { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 7px; color: #328666; background: #eaf6ef; }
+.search-result > span:nth-child(2) { display: flex; flex-direction: column; gap: 3px; }
+.search-result strong { color: #344854; font-size: 10.5px; font-weight: 650; }
+.search-result small { color: #94a1a9; font-size: 9px; }
+.search-result-enter { margin-left: auto; color: #a3afb6; font-size: 15px; }
+.search-no-results { padding: 20px 10px; color: #84939a; font-size: 10.5px; text-align: center; }
+.notification-popover { width: 340px; overflow: hidden; }
+.popover-head { padding: 15px 15px 11px; display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid #edf1f3; }
+.popover-head > div { display: flex; flex-direction: column; gap: 4px; }
+.popover-head strong { font-size: 12px; color: #2b3e4a; }
+.popover-head small { color: #8e9ca4; font-size: 9.5px; }
+.popover-text-action { padding: 0; background: none; border: 0; color: #208261; cursor: pointer; font-size: 9px; font-weight: 650; }
+.notification-list { max-height: 290px; overflow: auto; }
+.notification-item { width: 100%; padding: 11px 15px; display: flex; align-items: flex-start; gap: 9px; border: 0; border-bottom: 1px solid #f0f3f4; background: white; text-align: left; cursor: pointer; }
+.notification-item:hover { background: #f8fbf9; }
+.notification-severity { width: 8px; height: 8px; margin-top: 5px; flex: 0 0 auto; border-radius: 50%; background: #d49c47; }
+.notification-severity.severity-high, .notification-severity.severity-critical { background: #d4655c; }
+.notification-severity.severity-low { background: #4a9c77; }
+.notification-text { display: flex; flex-direction: column; gap: 5px; }
+.notification-text strong { color: #3e505b; font-size: 10px; font-weight: 620; }
+.notification-text small { color: #91a0a8; font-size: 9px; }
+.notification-empty { padding: 26px; display: flex; align-items: center; justify-content: center; gap: 9px; color: #37876a; font-size: 10.5px; }
+.popover-footer { display: flex; gap: 6px; padding: 10px 14px; color: #91a0a7; background: #fafcfb; font-size: 8.5px; }
+.profile-popover { width: 240px; padding: 8px; }
+.profile-popover-user { padding: 8px 7px 12px; display: flex; align-items: center; gap: 9px; border-bottom: 1px solid #eef1f3; }
+.profile-avatar-large { width: 35px; height: 35px; font-size: 10px; }
+.profile-popover-user > div { display: flex; min-width: 0; flex-direction: column; gap: 4px; }
+.profile-popover-user strong { color: #344955; font-size: 10.5px; }
+.profile-popover-user small { max-width: 160px; color: #8d9aa2; font-size: 8.5px; overflow: hidden; text-overflow: ellipsis; }
+.profile-role-label { padding: 10px 7px 7px; color: #83939a; font-size: 7.8px; font-weight: 740; letter-spacing: .65px; }
+.profile-menu-row { width: 100%; height: 33px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: #647680; text-align: left; cursor: pointer; font-size: 9.5px; }
+.profile-menu-row:hover { color: #267b5d; background: #f2f8f5; }
+.profile-popover-divider { height: 1px; margin: 7px 0; background: #eef1f3; }
+.profile-logout { color: #b9514c; }
+.profile-logout:hover { color: #a93c38; background: #fff3f1; }
+.mobile-menu-button, .mobile-close, .mobile-scrim { display: none; }
+.content-area { flex: 1; width: 100%; max-width: 1820px; margin: 0 auto; padding: 27px 30px 20px; }
+.app-footer { min-height: 39px; padding: 0 30px 11px; display: flex; align-items: center; justify-content: space-between; color: #98a5ad; font-size: 8.5px; }
+.app-footer > span { display: flex; align-items: center; gap: 7px; }
+.app-footer > span:last-child i { width: 3px; height: 3px; display: inline-block; border-radius: 50%; background: #c0cbd0; }
+.footer-live-dot { width: 5px; height: 5px; }
+
+/* page header and primitives */
+.page-content { width: 100%; max-width: 1550px; margin: 0 auto; animation: content-in .24s ease-out; }
+@keyframes content-in { from { opacity: .75; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
+.page-heading { margin: 0 0 21px; display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
+.page-heading-copy { min-width: 0; }
+.section-eyebrow, .panel-kicker, .small-overline { color: #84949c; font-size: 8.5px; font-weight: 760; letter-spacing: 1.05px; }
+.section-eyebrow { margin: 0 0 7px; }
+.page-heading h1 { margin: 0; color: #1c3140; font-size: 24px; line-height: 1.19; font-weight: 670; letter-spacing: -.85px; }
+.page-heading p { margin: 7px 0 0; color: #83919a; font-size: 11px; line-height: 1.5; }
+.page-heading-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
+.btn { min-height: 34px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 0 12px; border: 1px solid transparent; border-radius: 7px; cursor: pointer; font-size: 10px; font-weight: 620; white-space: nowrap; transition: transform .12s ease, box-shadow .12s ease, background .14s ease; }
+.btn:not(:disabled):active { transform: translateY(1px); }
+.btn-primary { color: #fff; background: #218968; border-color: #1d855f; box-shadow: 0 2px 4px rgba(31,132,98,.14); }
+.btn-primary:hover:not(:disabled) { background: #197a5c; box-shadow: 0 4px 10px rgba(31,132,98,.19); }
+.btn-secondary { color: #526671; background: #fff; border-color: #e2e9ed; box-shadow: 0 1px 2px rgba(30,50,65,.025); }
+.btn-secondary:hover:not(:disabled) { background: #f8fbfa; border-color: #cdded4; color: #237955; }
+.btn-ghost { color: #61747e; background: transparent; border-color: transparent; }
+.btn-ghost:hover:not(:disabled) { background: #eaf1ee; color: #278060; }
+.btn-danger { color: #a8423d; background: #fff2f0; border-color: #f4d9d5; }
+.btn-soft { color: #287c5c; background: #eaf7f0; border-color: #dcefe5; }
+.btn-sm { min-height: 29px; padding: 0 9px; border-radius: 6px; font-size: 9px; }
+.btn-md { min-height: 34px; }
+.panel { min-width: 0; background: #fff; border: 1px solid #e7ecef; border-radius: 11px; box-shadow: 0 2px 6px rgba(31,54,69,.025); }
+.panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; }
+.panel-header h2, .section-title-row h2 { margin: 7px 0 0; color: #263b49; font-size: 14px; line-height: 1.3; font-weight: 655; letter-spacing: -.2px; }
+.panel-header p, .section-title-row p { margin: 4px 0 0; color: #8c9aa2; font-size: 9.5px; line-height: 1.4; }
+.panel-link { display: inline-flex; align-items: center; gap: 6px; padding: 4px 0; color: #238361; background: transparent; border: 0; cursor: pointer; font-size: 9.5px; font-weight: 625; white-space: nowrap; }
+.panel-link:hover { color: #126747; }
+.icon-link { width: 29px; height: 29px; display: grid; place-items: center; padding: 0; color: #7b8d96; background: transparent; border: 1px solid transparent; border-radius: 6px; cursor: pointer; }
+.icon-link:hover { color: #24805f; background: #f1f7f4; border-color: #e0eee6; }
+.status-pill { display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-height: 19px; padding: 2px 7px; color: #667883; background: #f1f4f6; border: 1px solid #e9eef0; border-radius: 5px; font-size: 8px; line-height: 1.2; font-weight: 710; letter-spacing: .18px; white-space: nowrap; }
+.status-pill i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
+.status-green { color: #27845e; background: #edf8f2; border-color: #e1f1e9; }
+.status-amber { color: #a1792f; background: #fdf8ea; border-color: #f2e8cc; }
+.status-red { color: #bb5148; background: #fff1ef; border-color: #f5e1de; }
+.status-blue { color: #527bad; background: #eff5fc; border-color: #e4edf8; }
+.status-neutral { color: #72818a; background: #f3f5f6; border-color: #e9edef; }
+.demo-data-tag { height: 23px; display: inline-flex; align-items: center; gap: 5px; padding: 0 8px; border-radius: 5px; color: #347c62; background: #edf8f2; border: 1px solid #e0f0e6; font-size: 7.5px; letter-spacing: .6px; font-weight: 790; white-space: nowrap; }
+.demo-data-tag i { width: 5px; height: 5px; background: #36ad7c; border-radius: 50%; }
+.small-overline { display: block; margin-top: 10px; font-size: 7.5px; letter-spacing: .9px; }
+.section-title-row { display: flex; justify-content: space-between; align-items: center; }
+.empty-state { min-height: 175px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 7px; color: #8b9aa2; text-align: center; }
+.empty-state-icon { width: 40px; height: 40px; display: grid; place-items: center; margin-bottom: 4px; color: #328665; background: #eff8f3; border-radius: 10px; }
+.empty-state strong { color: #465b66; font-size: 12px; }
+.empty-state > span { max-width: 280px; font-size: 10px; line-height: 1.45; }
+
+/* overview dashboard */
+.live-summary-strip { min-height: 55px; margin-bottom: 15px; padding: 9px 13px; display: flex; align-items: center; gap: 11px; background: linear-gradient(100deg,#f0f8f3 0%,#f7faf8 48%,#fff 100%); border: 1px solid #e1eee6; border-radius: 9px; }
+.live-summary-icon { width: 33px; height: 33px; display: grid; flex: 0 0 auto; place-items: center; color: #2c9369; background: #e1f4e9; border-radius: 8px; }
+.live-summary-copy { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
+.live-summary-copy strong { color: #36584b; font-size: 10px; font-weight: 660; }
+.live-summary-copy span { color: #879b91; font-size: 9px; }
+.summary-data-label { margin-left: auto; display: flex; align-items: center; gap: 6px; color: #44856b; font-size: 7.7px; font-weight: 760; letter-spacing: .65px; white-space: nowrap; }
+.summary-pulse { width: 6px; height: 6px; border-radius: 50%; background: #36ae7d; box-shadow: 0 0 0 3px rgba(54,174,125,.13); }
+.live-summary-strip > button { display: flex; align-items: center; gap: 3px; padding: 4px 2px 4px 9px; color: #678378; background: none; border: 0; cursor: pointer; font-size: 8.5px; white-space: nowrap; }
+.metrics-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 11px; }
+.metric-card { min-width: 0; padding: 13px 14px 12px; background: #fff; border: 1px solid #e7ecef; border-radius: 10px; box-shadow: 0 1px 4px rgba(27,48,62,.02); transition: transform .16s ease, box-shadow .16s ease; }
+.metric-card:hover { transform: translateY(-2px); box-shadow: 0 7px 19px rgba(34,57,72,.07); }
+.metric-card-top { display: flex; align-items: center; justify-content: space-between; }
+.metric-icon { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 8px; }
+.metric-mint .metric-icon { color: #238963; background: #e9f7ef; }
+.metric-blue .metric-icon { color: #547eb2; background: #edf3fb; }
+.metric-amber .metric-icon { color: #ae8740; background: #fbf5e7; }
+.metric-violet .metric-icon { color: #766aab; background: #f2eff9; }
+.metric-rose .metric-icon { color: #b86d69; background: #fcf0ed; }
+.metric-delta { display: flex; align-items: center; gap: 2px; padding: 4px 6px; border-radius: 5px; font-size: 8px; font-weight: 680; white-space: nowrap; }
+.delta-up { color: #27845e; background: #eff8f2; }
+.delta-down { color: #b27942; background: #fbf5eb; }
