+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { Check, CircleAlert, Info, X } from 'lucide-react'
+
+export function Button({ children, variant = 'primary', size = 'md', className = '', onClick, type = 'button', disabled = false }: {
+  children: ReactNode; variant?: 'primary' | 'secondary' | 'ghost' | 'danger' | 'soft'; size?: 'sm' | 'md'; className?: string
+  onClick?: () => void; type?: 'button' | 'submit'; disabled?: boolean
+}) {
+  return <button type={type} disabled={disabled} onClick={onClick} className={`btn btn-${variant} btn-${size} ${className}`}>{children}</button>
+}
+
+export function StatusPill({ status, label, dot = false }: { status: string; label?: string; dot?: boolean }) {
+  const normalized = status.toLowerCase().replaceAll(' ', '-').replaceAll('_', '-')
+  const tone = ['online', 'active', 'normal', 'live', 'healthy', 'available', 'resolved', 'present'].includes(normalized) ? 'green'
+    : ['high', 'warning', 'acknowledged', 'reserved', 'connecting', 'degraded', 'scheduled---inactive'].includes(normalized) ? 'amber'
+    : ['critical', 'offline', 'over-capacity', 'error', 'maintenance', 'ignored'].includes(normalized) ? 'red'
+    : ['occupied', 'event-live'].includes(normalized) ? 'blue' : 'neutral'
+  return <span className={`status-pill status-${tone}`}>{dot && <i />}{label ?? status}</span>
+}
+
+export function PageHeading({ eyebrow, title, description, children }: { eyebrow?: string; title: string; description?: string; children?: ReactNode }) {
+  return <div className="page-heading"><div className="page-heading-copy">{eyebrow && <div className="section-eyebrow">{eyebrow}</div>}<h1>{title}</h1>{description && <p>{description}</p>}</div>{children && <div className="page-heading-actions">{children}</div>}</div>
+}
+
+export function SectionTitle({ title, description, action }: { title: string; description?: string; action?: ReactNode }) {
+  return <div className="section-title-row"><div><h2>{title}</h2>{description && <p>{description}</p>}</div>{action}</div>
+}
+
+export function EmptyState({ icon, title, description }: { icon?: ReactNode; title: string; description: string }) {
+  return <div className="empty-state"><div className="empty-state-icon">{icon ?? <Info size={20} />}</div><strong>{title}</strong><span>{description}</span></div>
+}
+
+export type ToastPayload = { title: string; message?: string; tone?: 'success' | 'warning' | 'error' }
+export function notify(title: string, message?: string, tone: ToastPayload['tone'] = 'success') {
+  window.dispatchEvent(new CustomEvent<ToastPayload>('campusiq:toast', { detail: { title, message, tone } }))
+}
+
+export function ToastHost() {
+  const [toast, setToast] = useState<ToastPayload | null>(null)
+  useEffect(() => {
+    const onToast = (event: Event) => {
+      const payload = (event as CustomEvent<ToastPayload>).detail
+      setToast(payload)
+      window.setTimeout(() => setToast(current => current === payload ? null : current), 3800)
+    }
+    window.addEventListener('campusiq:toast', onToast)
+    return () => window.removeEventListener('campusiq:toast', onToast)
+  }, [])
+  if (!toast) return null
+  const Icon = toast.tone === 'error' ? CircleAlert : toast.tone === 'warning' ? Info : Check
+  return <div className={`toast toast-${toast.tone ?? 'success'}`} role="status"><div className="toast-icon"><Icon size={17} /></div><div><strong>{toast.title}</strong>{toast.message && <span>{toast.message}</span>}</div><button aria-label="Dismiss notification" onClick={() => setToast(null)}><X size={16} /></button></div>
+}
+
+export const formatNumber = (value: number) => new Intl.NumberFormat('en-US').format(value)
+export const formatTime = (value?: string | null) => value ? new Date(value).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—'
+export const shortTimeAgo = (value?: string | null) => {
+  if (!value) return 'No recent update'
+  const diff = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 60000))
+  return diff < 1 ? 'Just now' : diff === 1 ? '1 min ago' : `${diff} min ago`
+}
