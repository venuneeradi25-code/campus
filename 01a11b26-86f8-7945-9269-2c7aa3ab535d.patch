new file mode 100644
index 0000000..8bb1414
--- /dev/null
+++ b/frontend/src/context/CampusContext.tsx
@@ -0,0 +1,88 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react'
+import type { ReactNode } from 'react'
+import type { Snapshot } from '../types'
+import { api } from '../services/api'
+
+type CampusValue = {
+  snapshot: Snapshot | null
+  loading: boolean
+  connected: boolean
+  lastSync: Date | null
+  error: string | null
+  refresh: () => Promise<void>
+  setSnapshot: (snapshot: Snapshot) => void
+}
+const CampusContext = createContext<CampusValue | null>(null)
+
+export function CampusProvider({ children }: { children: ReactNode }) {
+  const [snapshot, setSnapshot] = useState<Snapshot | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [connected, setConnected] = useState(false)
+  const [lastSync, setLastSync] = useState<Date | null>(null)
+  const [error, setError] = useState<string | null>(null)
+
+  const refresh = useCallback(async () => {
+    try {
+      const next = await api.snapshot()
+      setSnapshot(next)
+      setLastSync(new Date())
+      setError(null)
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Unable to refresh campus data.')
+    } finally {
+      setLoading(false)
+    }
+  }, [])
+
+  useEffect(() => {
+    let socket: WebSocket | null = null
+    let retry: number | undefined
+    let polling: number | undefined
+    let disposed = false
+    void refresh()
+
+    const connect = () => {
+      if (disposed) return
+      const scheme = window.location.protocol === 'https:' ? 'wss:' : 'ws:'
+      const protocols = ['campusiq']
+      const token = localStorage.getItem('campusiq-token')
+      if (token) protocols.push(`bearer.${token}`)
+      socket = new WebSocket(`${scheme}//${window.location.host}/ws/live`, protocols)
+      socket.onopen = () => { if (!disposed) setConnected(true) }
+      socket.onmessage = (event) => {
+        try {
+          const packet = JSON.parse(event.data)
+          if (packet.type === 'snapshot' && packet.payload) {
+            setSnapshot(packet.payload as Snapshot)
+            setLastSync(new Date())
+            setError(null)
+            setLoading(false)
+          }
+        } catch { /* ignore malformed/non-JSON telemetry frames */ }
+      }
+      socket.onclose = () => {
+        if (disposed) return
+        setConnected(false)
+        retry = window.setTimeout(connect, 2800)
+      }
+      socket.onerror = () => { socket?.close() }
+    }
+    connect()
+    polling = window.setInterval(() => { void refresh() }, 18000)
+    return () => {
+      disposed = true
+      if (retry) window.clearTimeout(retry)
+      if (polling) window.clearInterval(polling)
+      socket?.close()
+    }
+  }, [refresh])
+
+  const value = useMemo(() => ({ snapshot, loading, connected, lastSync, error, refresh, setSnapshot }), [snapshot, loading, connected, lastSync, error, refresh])
+  return <CampusContext.Provider value={value}>{children}</CampusContext.Provider>
+}
+
+export function useCampus() {
+  const value = useContext(CampusContext)
+  if (!value) throw new Error('useCampus must be used inside CampusProvider')
+  return value
+}
