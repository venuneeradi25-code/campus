+import { AuthProvider, useAuth } from './context/AuthContext'
+import { CampusProvider } from './context/CampusContext'
+import type { NavKey } from './types'
+import { LoginPage } from './pages/LoginPage'
+import { Shell } from './components/Shell'
+
+function AppRoot() {
+  const auth = useAuth()
+  const [page, setPage] = useState<NavKey>('overview')
+  if (auth.loading) {
+    return <div className="boot-screen"><div className="boot-mark"><Activity size={22} /></div><div className="boot-title">CampusIQ</div><div className="boot-caption">Connecting to campus intelligence…</div><div className="boot-line"><span /></div></div>
+  }
+  if (!auth.user) return <LoginPage />
+  return <CampusProvider key={auth.user.id}><Shell page={page} onPage={setPage} /></CampusProvider>
+}
+
+export default function App() {
+  return <AuthProvider><AppRoot /></AuthProvider>
+}
