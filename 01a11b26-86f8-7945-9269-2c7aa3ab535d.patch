+import { useMemo, useState } from 'react'
+import { BookOpen, Building2, CalendarClock, CheckCircle2, Computer, Filter, Monitor, Search, Settings2, Wrench } from 'lucide-react'
+import type { Resource } from '../types'
+import { useCampus } from '../context/CampusContext'
+import { useAuth } from '../context/AuthContext'
+import { api } from '../services/api'
+import { formatNumber, notify, PageHeading, StatusPill } from '../components/Primitives'
+
+const resourceIcon = [Monitor, Computer, Building2, Settings2, BookOpen, Wrench]
+export function ResourcesPage() {
+  const { snapshot, refresh } = useCampus()
+  const { user } = useAuth()
+  const [search, setSearch] = useState('')
+  const [category, setCategory] = useState('ALL')
+  const [status, setStatus] = useState('ALL')
+  const [busy, setBusy] = useState<string | null>(null)
+  const resources = snapshot!.resources
+  const categories = [...new Set(resources.map(resource => resource.category))]
+  const filtered = useMemo(() => resources.filter(resource => (category === 'ALL' || category === resource.category) && (status === 'ALL' || status === resource.status) && `${resource.name} ${resource.category} ${resource.detail}`.toLowerCase().includes(search.toLowerCase())), [resources, category, status, search])
+  const totals = resources.reduce<Record<string, number>>((acc, resource) => { acc.items += resource.quantity; const key = resource.status.toLowerCase(); acc[key] = (acc[key] ?? 0) + 1; return acc }, { items: 0, available: 0, occupied: 0, reserved: 0, maintenance: 0 })
+  const update = async (item: Resource, value: string) => {
+    if (user?.role === 'SECURITY ADMIN') { notify('Read-only role', 'Your role can review resources, but cannot update this inventory.', 'warning'); return }
+    setBusy(item.id)
+    try { await api.updateResource(item.id, value); await refresh(); notify('Resource status updated', `${item.name} → ${value.toLowerCase()}.`) }
+    catch (e) { notify('Could not update resource', e instanceof Error ? e.message : undefined, 'error') }
+    finally { setBusy(null) }
+  }
+  return <div className="page-content">
+    <PageHeading eyebrow="CAMPUS OPERATIONS / SHARED ASSETS" title="Resource directory" description="Find campus equipment and spaces, and keep availability current for operations teams."><span className="resource-inventory-label"><CheckCircle2 size={14} />{formatNumber(totals.items)} tracked items</span></PageHeading>
+    <div className="resource-stats-grid"><ResourceStat icon={<CheckCircle2 size={17} />} label="Available" value={totals.available} tone="green" /><ResourceStat icon={<Building2 size={17} />} label="In use" value={totals.occupied} tone="blue" /><ResourceStat icon={<CalendarClock size={17} />} label="Reserved" value={totals.reserved} tone="amber" /><ResourceStat icon={<Wrench size={17} />} label="Maintenance" value={totals.maintenance} tone="red" /></div>
+    <section className="panel resource-directory-panel"><div className="resource-directory-toolbar"><div><div className="panel-kicker">SHARED CAMPUS INVENTORY</div><h2>Find a resource</h2><p>Spaces, equipment and facilities across Lakeside University.</p></div><div className="resource-controls"><label className="resource-search"><Search size={15} /><input placeholder="Search resources" value={search} onChange={e => setSearch(e.target.value)} /></label><select aria-label="Filter by category" value={category} onChange={e => setCategory(e.target.value)}><option value="ALL">All categories</option>{categories.map(item => <option key={item}>{item}</option>)}</select><select aria-label="Filter by status" value={status} onChange={e => setStatus(e.target.value)}><option value="ALL">Any status</option>{['AVAILABLE','OCCUPIED','RESERVED','MAINTENANCE'].map(item => <option key={item} value={item}>{item.toLowerCase().replace(/^./, c => c.toUpperCase())}</option>)}</select></div></div>
+      <div className="resource-grid">{filtered.map((item, index) => <ResourceCard key={item.id} resource={item} icon={resourceIcon[index % resourceIcon.length]} disabled={busy === item.id || user?.role === 'SECURITY ADMIN'} onUpdate={value => void update(item, value)} />)}</div>{!filtered.length && <div className="table-empty"><Search size={20} /><strong>No resources found</strong><span>Change the category, status or search query.</span></div>}
+      <div className="resource-directory-footer"><span>Showing <strong>{filtered.length}</strong> of {resources.length} resource groups</span><span><span className="table-live-dot" />Availability updates as campus signals change.</span></div>
+    </section>
+    <div className="resource-policy"><Filter size={15} /><span>Bookings and resource reservations are managed by your institution’s scheduling system. Status changes here update the shared operational inventory.</span></div>
+  </div>
+}
+function ResourceCard({ resource, icon: Icon, disabled, onUpdate }: { resource: Resource; icon: typeof Monitor; disabled: boolean; onUpdate: (status: string) => void }) {
+  const statusLabels: Record<string,string> = { AVAILABLE: 'Available', OCCUPIED: 'Occupied', RESERVED: 'Reserved', MAINTENANCE: 'Maintenance' }
+  return <article className="resource-card"><div className={`resource-card-icon resource-${resource.status.toLowerCase()}`}><Icon size={17} /></div><div className="resource-card-head"><StatusPill status={resource.status} label={statusLabels[resource.status] ?? resource.status} /></div><span className="resource-category">{resource.category.toUpperCase()}</span><h3>{resource.name}</h3><p>{resource.detail}</p><div className="resource-card-lower"><span><Building2 size={13} />{buildingLabel(resource.buildingId)}</span><span><strong>{formatNumber(resource.quantity)}</strong> tracked</span></div><label className="resource-status-change"><span>Update status</span><select disabled={disabled} value={resource.status} onChange={e => onUpdate(e.target.value)} aria-label={`Update ${resource.name} status`}>{Object.entries(statusLabels).map(([key, label]) => <option key={key} value={key}>{label}</option>)}</select></label></article>
+}
+function ResourceStat({ icon, label, value, tone }: { icon: React.ReactNode; label: string; value: number; tone: string }) { return <div className={`panel resource-stat resource-stat-${tone}`}><span>{icon}</span><div><small>{label}</small><strong>{value.toString().padStart(2, '0')}</strong></div></div> }
+function buildingLabel(id: string) { return ({ main: 'Main Block', cse: 'CSE Block', 'ai-ds': 'AI & DS Block', library: 'Library', auditorium: 'Auditorium', labs: 'Innovation Labs', sports: 'Sports Complex' } as Record<string,string>)[id] ?? id }
