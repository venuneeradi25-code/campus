+        <div className="login-proof-row"><div className="proof-icon"><Activity size={19} /></div><div><strong>Live by design</strong><span>Campus signals, one operational picture.</span></div><div className="proof-pulse"><i /></div></div>
+      </div>
+      <div className="login-footer"><span>© 2026 CampusIQ</span><span>Built for better campus operations</span></div>
+    </div>
+    <div className="login-right">
+      <form className="login-card" onSubmit={submit}>
+        <div className="login-card-kicker"><span className="login-card-icon"><LockKeyhole size={17} /></span><span>SECURE WORKSPACE</span></div>
+        <h2>Welcome back</h2><p className="login-subtitle">Sign in to your campus operations workspace.</p>
+        <div className="login-tabs"><button type="button" className={mode === 'demo' ? 'active' : ''} onClick={() => { setMode('demo'); setError('') }}>Demo workspace</button><button type="button" className={mode === 'account' ? 'active' : ''} onClick={() => { setMode('account'); setError('') }}>Institution sign in</button></div>
+        {mode === 'demo' ? <>
+          <label className="form-label" htmlFor="role">Choose an access role</label>
+          <div className="role-select-wrap"><select id="role" value={role} onChange={e => setRole(e.target.value as Role)}>{roles.map(item => <option key={item} value={item}>{item}</option>)}</select><span className="role-chip"><ShieldCheck size={13} /> DEMO</span></div>
+          <div className="demo-note"><Sparkles size={16} /><span>Explore with realistic, clearly labelled sample campus data. No password required.</span></div>
+        </> : <>
+          <label className="form-label" htmlFor="email">Institution email</label><input className="login-input" id="email" type="email" autoComplete="username" placeholder="you@university.edu" value={email} onChange={e => setEmail(e.target.value)} required />
+          <label className="form-label password-label" htmlFor="password">Password</label><div className="password-wrap"><input className="login-input" id="password" type={showPassword ? 'text' : 'password'} autoComplete="current-password" placeholder="Your password" value={password} onChange={e => setPassword(e.target.value)} required /><button type="button" aria-label="Show password" onClick={() => setShowPassword(!showPassword)}>{showPassword ? <EyeOff size={17} /> : <Eye size={17} />}</button></div>
+          <p className="institution-hint">Institution-provisioned accounts are configured by your CampusIQ administrator.</p>
+        </>}
+        {(error || authError) && <div className="login-error">{error || authError}</div>}
+        <button className="login-submit" type="submit" disabled={working}>{working ? <span className="button-spinner" /> : mode === 'demo' ? <Sparkles size={17} /> : <LockKeyhole size={16} />}<span>{working ? 'Securing your session…' : mode === 'demo' ? 'Enter demo workspace' : 'Sign in securely'}</span>{!working && <ArrowRight size={16} />}</button>
+        <div className="login-privacy"><ShieldCheck size={15} /><span>Secure access · Role-based permissions · Privacy-first by default</span></div>
+      </form>
+      <div className="login-assurance"><span className="assurance-dot" /> Campus telemetry is simulated in this demo environment.</div>
+    </div>
+  </main>
+}
