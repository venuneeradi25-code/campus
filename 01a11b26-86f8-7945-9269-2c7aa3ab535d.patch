+@app.patch("/api/cameras/{camera_id}")
+def update_camera(camera_id: str, body: CameraUpdate, user: dict = Depends(require_roles("SUPER ADMIN", "SECURITY ADMIN")), db: Session = Depends(get_db)):
+    camera = db.get(Camera, camera_id)
+    if not camera:
+        raise HTTPException(status_code=404, detail="Camera not found.")
+    data = body.model_dump(exclude_unset=True)
+    next_source_type = data.get("source_type", camera.source_type)
+    if next_source_type == "RTSP":
+        if "source_uri" in data:
+            source_uri = data["source_uri"].strip() if data["source_uri"] else None
+            if not source_uri or not source_uri.lower().startswith("rtsp://"):
+                raise HTTPException(status_code=422, detail="RTSP sources must include a valid rtsp:// URL.")
+            camera.source_uri = protect_camera_source(source_uri, "RTSP")
+        elif camera.source_type != "RTSP" or not camera.source_uri:
+            raise HTTPException(status_code=422, detail="An RTSP camera requires a configured source URL.")
+    else:
+        if data.get("source_uri"):
+            raise HTTPException(status_code=422, detail="A source URL can only be configured for an RTSP camera.")
+        if "source_uri" in data or ("source_type" in data and next_source_type != camera.source_type):
+            camera.source_uri = None
+    for key in ("name", "location", "building_id", "ai_enabled", "stream_active", "source_type"):
+        if key in data and data[key] is not None:
+            setattr(camera, key, data[key])
+    if camera.stream_active:
+        camera.status = "ONLINE" if camera.source_type == "DEMO" else "CONNECTING"
+    else:
+        camera.status = "OFFLINE"
+        camera.fps = 0
+    camera.last_updated = utcnow()
+    db.commit()
+    return camera_payload(camera)
+
