+        db.commit()
+        return {"ok": True, "message": f"RTSP feed connected. Anonymous sample count: {camera.people_count} people, {camera.vehicle_count} vehicles."}
+    except (VisionError, ValueError) as exc:
+        camera.status, camera.fps = "OFFLINE", 0
